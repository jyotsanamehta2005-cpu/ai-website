function MyApplications({ user, settings, onUpdateUser, onBrowseJobs }) {
  const applications = user.applications || [];
  const [view, setView] = useState('tracker'); // tracker | calendar | saved
  const [filter, setFilter] = useState('all'); // tracker filter
  const [selectedId, setSelectedId] = useState(null);

  const selected = applications.find(a => a.id === selectedId);

  const savedJobs    = applications.filter(a => a.status === 'saved');
  const activeApps   = applications.filter(a => a.status !== 'saved');

  const updateApp = async (id, patch) => {
    const now = new Date().toISOString();
    const next = applications.map(a => {
      if (a.id !== id) return a;
      const updated = { ...a, ...patch };
      // Log status changes in history
      if (patch.status && patch.status !== a.status) {
        const meta = statusMeta(patch.status);
        updated.history = [...(a.history || []), { at: now, event: `Status changed to ${meta.label}` }];
        if (patch.status !== 'saved' && !a.appliedAt) updated.appliedAt = now;
      }
      return updated;
    });
    await onUpdateUser({ applications: next });
  };

  const deleteApp = async (id) => {
    if (!confirm('Remove this application from your tracker?')) return;
    await onUpdateUser({ applications: applications.filter(a => a.id !== id) });
    if (selectedId === id) setSelectedId(null);
  };

  if (selected) {
    return (
      <ApplicationDetail
        app={selected}
        onBack={() => setSelectedId(null)}
        onUpdate={(patch) => updateApp(selected.id, patch)}
        onDelete={() => deleteApp(selected.id)}
      />
    );
  }

  // STATS
  const stats = {
    total: applications.length,
    active: activeApps.length,
    saved: savedJobs.length,
    offers: applications.filter(a => a.status === 'offer').length,
    interviews: applications.filter(a => a.status === 'interview' || a.status === 'shortlisted').length,
  };

  // Upcoming deadlines (next 14 days)
  const upcomingDeadlines = applications
    .filter(a => a.lastDate && daysUntil(a.lastDate) !== null && daysUntil(a.lastDate) >= 0 && daysUntil(a.lastDate) <= 14)
    .sort((a, b) => new Date(a.lastDate) - new Date(b.lastDate));

  return (
    <div className="fade" style={{ padding: 44, maxWidth: 1180, margin: '0 auto' }}>
      <div className="fadeUp" style={{ marginBottom: 24 }}>
        <h1 style={{
          fontFamily: fontDisplay, fontSize: 32, fontWeight: 700, color: S.ink,
          margin: '0 0 8px', letterSpacing: '-0.02em',
        }}>My Applications</h1>
        <p style={{ fontSize: 15, color: S.muted, margin: 0 }}>
          Track every job you've applied to, save ones to apply later, and never miss a deadline.
        </p>
      </div>

      {/* Stats strip */}
      <div className="fadeUp" style={{
        display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: 12,
        marginBottom: 22, animationDelay: '0.05s',
      }}>
        <StatTile label="Total"      value={stats.total}      color={S.ink} />
        <StatTile label="Active"     value={stats.active}     color={S.primary} accent />
        <StatTile label="Saved"      value={stats.saved}      color="#64748B" />
        <StatTile label="Interviews" value={stats.interviews} color="#7C3AED" />
        <StatTile label="Offers"     value={stats.offers}     color="#10B981" />
      </div>

      {/* Upcoming deadlines banner */}
      {upcomingDeadlines.length > 0 && (
        <div className="fadeUp" style={{
          marginBottom: 22, padding: 16,
          background: 'linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%)',
          borderRadius: 14, border: '1px solid #FCD34D',
          display: 'flex', alignItems: 'center', gap: 14,
          animationDelay: '0.08s',
        }}>
          <span style={{ fontSize: 24 }}>⏰</span>
          <div style={{ flex: 1, minWidth: 0 }}>
            <div style={{ fontSize: 13, fontWeight: 700, color: '#92400E', marginBottom: 2 }}>
              {upcomingDeadlines.length} upcoming deadline{upcomingDeadlines.length > 1 ? 's' : ''} this fortnight
            </div>
            <div style={{ fontSize: 12, color: '#92400E', opacity: 0.85 }}>
              Closest: <strong>{upcomingDeadlines[0].jobTitle}</strong> at {upcomingDeadlines[0].companyName} — {fmtRelativeDate(upcomingDeadlines[0].lastDate)}
            </div>
          </div>
          <button onClick={() => setView('calendar')} style={{
            padding: '8px 16px', background: '#92400E', color: '#fff',
            border: 'none', borderRadius: 100,
            fontSize: 12, fontWeight: 700, cursor: 'pointer', fontFamily: fontBody,
            flexShrink: 0,
          }}>View calendar →</button>
        </div>
      )}

      {/* Tab switcher */}
      <div className="fadeUp" style={{
        display: 'flex', gap: 6, marginBottom: 18,
        background: S.bgSoft, padding: 5, borderRadius: 12,
        border: `1px solid ${S.line}`, animationDelay: '0.1s',
      }}>
        {[
          { k: 'tracker',  l: '📋 Tracker',  c: stats.active },
