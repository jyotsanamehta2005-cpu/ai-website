// APTITUDE TEST — student-facing
// ---------------------------------------------------------------------------
function AptitudeTest({ user, settings, onBack }) {
  const [phase, setPhase] = useState('setup'); // setup | testing | results
  const [presetId, setPresetId] = useState('tcs_nqt');
  const [questions, setQuestions] = useState([]);
  const [answers, setAnswers] = useState([]);
  const [marked, setMarked] = useState([]); // booleans per question
  const [currentQ, setCurrentQ] = useState(0);
  const [loading, setLoading] = useState(false);
  const [loadingStage, setLoadingStage] = useState('');
  const [error, setError] = useState('');
  const [startTime, setStartTime] = useState(null);
  const [endTime, setEndTime] = useState(null);
  const [timePerQuestion, setTimePerQuestion] = useState([]); // sec spent on each
  const [questionStart, setQuestionStart] = useState(null);
  const [report, setReport] = useState(null);

  const preset = APTITUDE_PRESETS[presetId];

  const handleStart = async () => {
    setError(''); setLoading(true);
    setLoadingStage(`Generating ${preset.totalQuestions} fresh questions`);
    try {
      const qs = await generateAptitudeTest(preset);
      if (!qs.length) throw new Error('No questions generated');
      setQuestions(qs);
      setAnswers(new Array(qs.length).fill(null));
      setMarked(new Array(qs.length).fill(false));
      setTimePerQuestion(new Array(qs.length).fill(0));
      setCurrentQ(0);
      const now = Date.now();
      setStartTime(now);
      setQuestionStart(now);
      setPhase('testing');
    } catch (e) {
      setError('Could not generate the test. Please try again.');
    }
    setLoading(false);
  };

  const recordTimeForCurrent = () => {
    if (questionStart) {
      const delta = Math.floor((Date.now() - questionStart) / 1000);
      setTimePerQuestion(prev => {
        const next = [...prev];
        next[currentQ] = (next[currentQ] || 0) + delta;
        return next;
      });
    }
  };

  const navigateTo = (idx) => {
    recordTimeForCurrent();
    setCurrentQ(idx);
    setQuestionStart(Date.now());
  };

  const handleSelect = (optionIdx) => {
    const next = [...answers];
    next[currentQ] = optionIdx;
    setAnswers(next);
  };

  const handleMark = () => {
    const next = [...marked];
    next[currentQ] = !next[currentQ];
    setMarked(next);
  };

  const handleClear = () => {
    const next = [...answers];
    next[currentQ] = null;
    setAnswers(next);
  };

  const handleSubmit = () => {
    recordTimeForCurrent();
    const finishedAt = Date.now();
    setEndTime(finishedAt);
    const totalTimeSec = Math.floor((finishedAt - startTime) / 1000);
    // Use the most up-to-date time array
    const currentTime = (() => {
      const arr = [...timePerQuestion];
      if (questionStart) {
        const delta = Math.floor((Date.now() - questionStart) / 1000);
        arr[currentQ] = (arr[currentQ] || 0) + delta;
      }
      return arr;
    })();

    const result = gradeAptitudeTest({
      preset, questions, answers, timePerQuestion: currentTime, totalTimeSec,
    });
    setReport(result);
    setPhase('results');
  };

  const handleRestart = () => {
    setPhase('setup'); setQuestions([]); setAnswers([]); setMarked([]);
    setCurrentQ(0); setTimePerQuestion([]); setReport(null); setError('');
    setStartTime(null); setEndTime(null);
  };

  return (
    <div className="fade" style={{ padding: 44, maxWidth: 1080, margin: '0 auto' }}>
      <button onClick={phase === 'testing'
          ? () => { if (confirm('Quit the test? Your progress will be lost.')) handleRestart(); }
          : onBack}
        style={{
          background: 'none', border: 'none', fontSize: 13, fontWeight: 600,
          color: S.muted, padding: 0, marginBottom: 22, cursor: 'pointer',
          fontFamily: fontBody,
        }}>← {phase === 'testing' ? 'Quit test' : 'Back to dashboard'}</button>

      {phase === 'setup' && (
        <AptitudeSetup
          preset={preset} presetId={presetId} setPresetId={setPresetId}
          loading={loading} loadingStage={loadingStage}
          error={error} onStart={handleStart}
        />
      )}

      {phase === 'testing' && questions.length > 0 && (
        <AptitudeSession
          preset={preset} questions={questions}
          answers={answers} marked={marked}
          currentQ={currentQ}
          startTime={startTime}
          onSelect={handleSelect}
          onMark={handleMark}
          onClear={handleClear}
          onNavigate={navigateTo}
          onSubmit={handleSubmit}
        />
      )}

      {phase === 'results' && report && (
        <AptitudeReport
          report={report} preset={preset}
          onRestart={handleRestart}
          onTryAgain={handleStart}
        />
      )}
    </div>
  );
}

