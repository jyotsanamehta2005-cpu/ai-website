      }}>{app.companyLogo || '🏢'}</div>

      <div style={{ minWidth: 0 }}>
        <div style={{
          fontFamily: fontDisplay, fontSize: 15, fontWeight: 700, color: S.ink,
          letterSpacing: '-0.01em', lineHeight: 1.25,
