            <CategoryBar label="Keywords"   value={result.scoreBreakdown?.keywords  ?? 0}  hint="Role-relevant terms" />
            <CategoryBar label="Impact"     value={result.scoreBreakdown?.impact    ?? 0}  hint="Action verbs, metrics" />
