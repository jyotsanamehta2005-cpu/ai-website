  const hasResume = !!user.profile;
  const jobs = settings.jobs || [];
  const selectedJob = jobs.find(j => j.id === selectedJobId);

  const handleStart = async () => {
    if (!role && !selectedJob) {
      return setError('Pick a role to interview for.');
    }
    setError('');
    setLoading(true);
    setLoadingStage('Generating your interview questions');
    try {
      const qs = await generateInterviewQuestions({
        profile: user.profile,
        role: selectedJob ? `${selectedJob.title} at ${selectedJob.companyName}` : role,
        mode,
        jobContext: selectedJob,
      });
      if (!qs.length) throw new Error('No questions generated');
      setQuestions(qs);
      setAnswers(new Array(qs.length).fill(''));
      setCurrentQ(0);
      setCurrentAnswer('');
      setStartTime(Date.now());
      setPhase('interviewing');
    } catch (e) {
      setError('Could not generate questions. Please try again.');
    }
    setLoading(false);
  };

  const handleNextQuestion = () => {
    const nextAnswers = [...answers];
    nextAnswers[currentQ] = currentAnswer.trim();
    setAnswers(nextAnswers);
    setCurrentAnswer('');
    if (currentQ < questions.length - 1) {
      setCurrentQ(currentQ + 1);
    } else {
      // Final question — go to evaluation
      handleEvaluate(nextAnswers);
    }
  };

  const handleSkip = () => {
    const nextAnswers = [...answers];
    nextAnswers[currentQ] = '';
    setAnswers(nextAnswers);
    setCurrentAnswer('');
    if (currentQ < questions.length - 1) {
      setCurrentQ(currentQ + 1);
    } else {
      handleEvaluate(nextAnswers);
    }
  };

  const handleEvaluate = async (finalAnswers) => {
    setPhase('evaluating');
    setLoading(true);
    setLoadingStage('Reading your transcript');
    try {
      await new Promise(r => setTimeout(r, 400));
      setLoadingStage('Scoring your answers');
      const result = await evaluateInterview({
        profile: user.profile,
        role: selectedJob ? `${selectedJob.title} at ${selectedJob.companyName}` : role,
        mode,
        jobContext: selectedJob,
        questions,
        answers: finalAnswers,
      });
      setLoadingStage('Building your report');
      await new Promise(r => setTimeout(r, 300));
      setReport(result);
      setPhase('results');
    } catch (e) {
      setError('Could not evaluate the interview. Please try again.');
      setPhase('interviewing');
    }
    setLoading(false);
  };

  const handleRestart = () => {
    setPhase('setup'); setQuestions([]); setAnswers([]); setCurrentQ(0);
    setCurrentAnswer(''); setReport(null); setError('');
  };

  return (
    <div className="fade" style={{ padding: 44, maxWidth: 920, margin: '0 auto' }}>
      <button onClick={phase === 'setup' || phase === 'results' ? onBack : handleRestart}
        style={{
          background: 'none', border: 'none', fontSize: 13, fontWeight: 600,
          color: S.muted, padding: 0, marginBottom: 22, cursor: 'pointer',
          fontFamily: fontBody,
        }}>
        ← {phase === 'setup' || phase === 'results' ? 'Back to dashboard' : 'Restart interview'}
      </button>

      {phase === 'setup' && (
        <InterviewSetup
          user={user} jobs={jobs}
          mode={mode} setMode={setMode}
          role={role} setRole={setRole}
          selectedJobId={selectedJobId} setSelectedJobId={setSelectedJobId}
          hasResume={hasResume}
          loading={loading} loadingStage={loadingStage}
          error={error}
          onStart={handleStart}
          onUpload={onUpload}
        />
      )}

      {phase === 'interviewing' && questions.length > 0 && (
        <InterviewSession
          questions={questions}
          currentQ={currentQ}
          currentAnswer={currentAnswer} setCurrentAnswer={setCurrentAnswer}
          onNext={handleNextQuestion}
          onSkip={handleSkip}
          startTime={startTime}
        />
      )}

      {phase === 'evaluating' && (
        <div style={{
          padding: 60, background: S.bgSoft, borderRadius: 18,
          border: `1px solid ${S.line}`, textAlign: 'center',
        }}>
          <div style={{
            width: 64, height: 64, border: `3px solid ${S.bgTint}`,
            borderTopColor: S.primary, borderRadius: '50%',
            animation: 'spin 0.9s linear infinite',
            margin: '0 auto 20px',
          }} />
          <div style={{
            fontFamily: fontDisplay, fontSize: 20, fontWeight: 700,
            color: S.ink, marginBottom: 6, letterSpacing: '-0.015em',
          }}>{loadingStage}…</div>
          <div style={{ fontSize: 13, color: S.muted, fontWeight: 600, letterSpacing: '0.05em' }}>
            CLAUDE IS REVIEWING YOUR ANSWERS
          </div>
        </div>
      )}

      {phase === 'results' && report && (
        <InterviewReport
          report={report}
          questions={questions}
          answers={answers}
          mode={mode}
          role={selectedJob ? `${selectedJob.title} at ${selectedJob.companyName}` : role}
          onRestart={handleRestart}
          onTryAgain={handleStart}
        />
      )}
    </div>
  );
}

