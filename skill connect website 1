// CALENDAR VIEW
// ---------------------------------------------------------------------------
function CalendarView({ apps, onOpen }) {
  const withDeadlines = apps.filter(a => a.lastDate).sort((a, b) => new Date(a.lastDate) - new Date(b.lastDate));

  const overdue   = withDeadlines.filter(a => daysUntil(a.lastDate) < 0 && a.status !== 'rejected' && a.status !== 'offer');
  const thisWeek  = withDeadlines.filter(a => {
    const d = daysUntil(a.lastDate);
    return d !== null && d >= 0 && d <= 7;
  });
  const next2Wks  = withDeadlines.filter(a => {
    const d = daysUntil(a.lastDate);
    return d !== null && d > 7 && d <= 14;
  });
  const later     = withDeadlines.filter(a => daysUntil(a.lastDate) > 14);

  if (withDeadlines.length === 0) {
    return (
      <div style={{
        padding: 40, background: S.bgSoft, borderRadius: 14,
        border: `1px solid ${S.line}`, textAlign: 'center',
      }}>
        <div style={{ fontSize: 32, marginBottom: 10 }}>📅</div>
        <div style={{
          fontFamily: fontDisplay, fontSize: 17, fontWeight: 700, color: S.ink,
          marginBottom: 6,
        }}>No deadlines yet</div>
        <div style={{ fontSize: 13, color: S.muted }}>
          Applications you've saved or applied to with a "last date to apply" will appear here.
        </div>
      </div>
    );
  }

  return (
    <div className="fade">
      <DeadlineGroup title="⚠️ Overdue"      apps={overdue}  onOpen={onOpen} tint="#FEE2E2" border="#FECACA" textColor="#991B1B" />
      <DeadlineGroup title="🔥 This Week"     apps={thisWeek} onOpen={onOpen} tint="#FEF3C7" border="#FCD34D" textColor="#92400E" />
      <DeadlineGroup title="📅 Next 2 Weeks"  apps={next2Wks} onOpen={onOpen} tint={S.bgTint} border="#A7F3D0" textColor="#065F46" />
      <DeadlineGroup title="🗓️ Later"          apps={later}    onOpen={onOpen} tint={S.bgSoft} border={S.line} textColor={S.text} />
    </div>
  );
}

