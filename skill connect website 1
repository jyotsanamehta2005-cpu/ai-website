// ---------------------------------------------------------------------------
// TRACKER VIEW — list of applications grouped by status
// ---------------------------------------------------------------------------
function TrackerView({ apps, filter, setFilter, onOpen, onStatusChange }) {
  const filtered = filter === 'all' ? apps : apps.filter(a => a.status === filter);

  const grouped = {};
  filtered.forEach(a => {
    grouped[a.status] = grouped[a.status] || [];
    grouped[a.status].push(a);
  });

  const orderedStatuses = APP_STATUSES.filter(s => s.k !== 'saved');

  return (
    <div className="fade">
      {/* Filter pills */}
      <div style={{ display: 'flex', gap: 6, marginBottom: 18, flexWrap: 'wrap' }}>
        <FilterPill label="All" active={filter === 'all'} onClick={() => setFilter('all')}
          count={apps.length} />
        {orderedStatuses.map(s => {
          const c = apps.filter(a => a.status === s.k).length;
          if (c === 0) return null;
          return (
            <FilterPill key={s.k} label={s.label} active={filter === s.k}
              onClick={() => setFilter(s.k)} count={c}
              color={s.color} bg={s.bg} />
          );
        })}
      </div>

      {filtered.length === 0 ? (
        <div style={{
          padding: 40, background: S.bgSoft, borderRadius: 14,
          border: `1px solid ${S.line}`, textAlign: 'center',
          fontSize: 14, color: S.muted,
        }}>No applications in this filter.</div>
      ) : filter === 'all' ? (
        // Grouped view
        orderedStatuses.map(s => {
          const list = grouped[s.k];
          if (!list?.length) return null;
          return (
            <div key={s.k} style={{ marginBottom: 22 }}>
              <div style={{
                display: 'flex', alignItems: 'center', gap: 10, marginBottom: 10,
              }}>
                <span style={{
                  padding: '4px 12px', background: s.bg, color: s.color,
                  borderRadius: 100, fontSize: 11, fontWeight: 800,
                  letterSpacing: '0.06em', textTransform: 'uppercase',
                }}>{s.label}</span>
                <span style={{ fontSize: 12, color: S.muted, fontWeight: 600 }}>
                  {list.length} {list.length === 1 ? 'job' : 'jobs'}
                </span>
              </div>
              <div style={{ display: 'grid', gap: 10 }}>
                {list.map(app => (
                  <ApplicationRow key={app.id} app={app} onOpen={() => onOpen(app.id)}
                    onStatusChange={(status) => onStatusChange(app.id, status)} />
                ))}
              </div>
            </div>
          );
        })
      ) : (
        <div style={{ display: 'grid', gap: 10 }}>
          {filtered.map(app => (
            <ApplicationRow key={app.id} app={app} onOpen={() => onOpen(app.id)}
              onStatusChange={(status) => onStatusChange(app.id, status)} />
          ))}
        </div>
      )}
    </div>
  );
}

function FilterPill({ label, active, onClick, count, color, bg }) {
  return (
    <button onClick={onClick} style={{
      padding: '6px 12px',
      background: active ? (bg || S.primary) : '#fff',
      color: active ? (color || '#fff') : S.text,
      border: `1.5px solid ${active ? (color || S.primary) : S.line}`,
      borderRadius: 100, fontSize: 12, fontWeight: 700,
      cursor: 'pointer', fontFamily: fontBody,
      display: 'inline-flex', alignItems: 'center', gap: 6,
    }}>
