function JobCard({ job, match, isSaved, onSave, onUnsave, onClick }) {
  const daysAgo = job.fetchedAt
    ? Math.floor((Date.now() - new Date(job.fetchedAt).getTime()) / 86400000)
    : null;
  const fresh = daysAgo !== null && daysAgo <= 3;

  // Match badge styling
  const tierStyle = match ? ({
    strong:  { bg: '#D1FAE5', fg: '#065F46', label: 'Strong fit' },
    good:    { bg: '#DBEAFE', fg: '#1E40AF', label: 'Good fit' },
    stretch: { bg: '#FEF3C7', fg: '#92400E', label: 'Stretch' },
    weak:    { bg: '#FEE2E2', fg: '#991B1B', label: 'Long shot' },
  }[match.tier] || { bg: '#F3F4F6', fg: '#374151', label: 'Match' }) : null;

  return (
    <div onClick={onClick} className="s-card s-card-hover"
      style={{
        padding: 18, background: S.bg,
        border: `1px solid ${match && match.tier === 'strong' ? '#A7F3D0' : S.line}`,
        borderRadius: 14, cursor: 'pointer',
        position: 'relative',
      }}>
      {/* Match score badge — top right */}
      {match && (
        <div style={{
          position: 'absolute', top: 12, right: 12,
          padding: '4px 10px',
          background: tierStyle.bg, color: tierStyle.fg,
          borderRadius: 100, fontSize: 11, fontWeight: 800,
          display: 'flex', alignItems: 'center', gap: 5,
          fontFamily: fontBody, letterSpacing: '-0.005em',
        }}>
          <span>{match.score}%</span>
          <span style={{ opacity: 0.75, fontSize: 10 }}>· {tierStyle.label}</span>
        </div>
      )}

      <div style={{ display: 'flex', alignItems: 'flex-start', gap: 12, marginBottom: 12, paddingRight: match ? 90 : 0 }}>
        <div style={{
          width: 44, height: 44, borderRadius: 11,
          background: `linear-gradient(135deg, ${S.primary}, ${S.primaryMid})`,
          color: '#fff', flexShrink: 0,
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          fontSize: 20,
        }}>{job.companyLogo || '🏢'}</div>
        <div style={{ flex: 1, minWidth: 0 }}>
          <div style={{
            fontFamily: fontDisplay,
            fontSize: 16, fontWeight: 700, color: S.ink,
            marginBottom: 2, lineHeight: 1.25,
            display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical',
            overflow: 'hidden',
          }}>{job.title}</div>
          <div style={{ fontSize: 12.5, color: S.primary, fontWeight: 600 }}>
            {job.companyName}
          </div>
        </div>
        {fresh && !match && (
          <span style={{
            padding: '3px 8px', background: S.accentBg, color: '#065F46',
            borderRadius: 100, fontSize: 9, fontWeight: 800, letterSpacing: '0.08em',
            flexShrink: 0,
          }}>NEW</span>
        )}
      </div>

      <div style={{
        display: 'flex', flexWrap: 'wrap', gap: 6, marginBottom: 12,
      }}>
        {job.type && <Chip>{job.type}</Chip>}
        {job.location && <Chip icon="📍">{job.location}</Chip>}
        {job.experience && <Chip>{job.experience}</Chip>}
      </div>

      {/* Match insight (instead of generic description when matched) */}
      {match && match.whyItFits ? (
        <p style={{
          margin: 0, fontSize: 13, color: S.text, lineHeight: 1.5,
          padding: 10, background: S.bgTint, borderRadius: 8,
          display: '-webkit-box', WebkitLineClamp: 3, WebkitBoxOrient: 'vertical',
          overflow: 'hidden',
        }}>
          <strong style={{ color: S.primary }}>Why this fits:</strong> {match.whyItFits}
        </p>
      ) : (
        <p style={{
          margin: 0, fontSize: 13, color: S.textSoft, lineHeight: 1.5,
          display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical',
          overflow: 'hidden',
        }}>{job.description}</p>
      )}

      {/* Missing skills if matched */}
      {match && match.missing && match.missing.length > 0 && (
        <div style={{
          marginTop: 8, display: 'flex', flexWrap: 'wrap', gap: 5,
        }}>
          {match.missing.slice(0, 2).map((m, i) => (
            <span key={i} style={{
              padding: '2px 8px', background: '#FEF3C7', color: '#92400E',
              borderRadius: 100, fontSize: 10, fontWeight: 600,
            }}>Missing: {m}</span>
          ))}
        </div>
      )}

      <div style={{
        marginTop: 14, paddingTop: 12, borderTop: `1px solid ${S.lineSoft}`,
        display: 'flex', justifyContent: 'space-between', alignItems: 'center',
        fontSize: 11, color: S.muted,
      }}>
        <span>
          {job.lastDate ? `Apply by ${job.lastDate}` : daysAgo !== null ? `Posted ${daysAgo === 0 ? 'today' : `${daysAgo}d ago`}` : ''}
