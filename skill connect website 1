function ApplicationDetail({ app, onBack, onUpdate, onDelete }) {
  const meta = statusMeta(app.status);
  const [notes, setNotes] = useState(app.notes || '');
  const [nextStep, setNextStep] = useState(app.nextStep || '');
  const [nextStepDate, setNextStepDate] = useState(app.nextStepDate || '');

  const saveDirty = () => {
    if (notes !== (app.notes || '') || nextStep !== (app.nextStep || '') || nextStepDate !== (app.nextStepDate || '')) {
      onUpdate({ notes, nextStep, nextStepDate });
    }
  };

  return (
    <div className="fade" style={{ padding: 44, maxWidth: 920, margin: '0 auto' }}>
      <button onClick={() => { saveDirty(); onBack(); }}
        style={{
          background: 'none', border: 'none', fontSize: 13, fontWeight: 600,
          color: S.muted, padding: 0, marginBottom: 22, cursor: 'pointer',
          fontFamily: fontBody,
        }}>← Back to applications</button>

      <div className="fadeUp" style={{
        padding: 28, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 18, marginBottom: 16,
      }}>
        <div style={{ display: 'flex', alignItems: 'flex-start', gap: 16, marginBottom: 16 }}>
          <div style={{
            width: 56, height: 56, borderRadius: 12,
            background: `linear-gradient(135deg, ${S.primary}, ${S.primaryMid})`,
            color: '#fff', flexShrink: 0,
            display: 'flex', alignItems: 'center', justifyContent: 'center',
            fontSize: 24,
          }}>{app.companyLogo || '🏢'}</div>
          <div style={{ flex: 1, minWidth: 0 }}>
            <h1 style={{
              fontFamily: fontDisplay, fontSize: 22, fontWeight: 700, color: S.ink,
              margin: '0 0 4px', letterSpacing: '-0.015em', lineHeight: 1.25,
            }}>{app.jobTitle}</h1>
            <div style={{ fontSize: 14, color: S.primary, fontWeight: 700 }}>
              {app.companyName}
            </div>
            <div style={{ fontSize: 12, color: S.muted, marginTop: 6 }}>
              {app.location && `📍 ${app.location}`}
              {app.type && (app.location ? ' · ' : '') + app.type}
            </div>
          </div>
          <button onClick={onDelete} style={{
            padding: '7px 14px', background: '#fff', color: '#DC2626',
            border: `1.5px solid ${S.line}`, borderRadius: 100,
            fontSize: 12, fontWeight: 700, cursor: 'pointer', fontFamily: fontBody,
            flexShrink: 0,
          }}>Remove</button>
        </div>

        {/* Status updater */}
        <div style={{
          padding: 16, background: S.bgSoft, borderRadius: 12,
          border: `1px solid ${S.line}`,
        }}>
          <div style={{
            fontSize: 11, fontWeight: 700, color: S.muted,
            letterSpacing: '0.08em', marginBottom: 10,
          }}>STATUS</div>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
            {APP_STATUSES.map(s => {
              const active = app.status === s.k;
              return (
                <button key={s.k} onClick={() => onUpdate({ status: s.k })}
                  style={{
                    padding: '7px 13px',
                    background: active ? s.color : '#fff',
                    color: active ? '#fff' : s.color,
                    border: `1.5px solid ${active ? s.color : s.color + '40'}`,
                    borderRadius: 100, fontSize: 12, fontWeight: 700,
                    cursor: 'pointer', fontFamily: fontBody,
                  }}>{s.label}</button>
              );
            })}
          </div>
        </div>
      </div>

      {/* Key dates */}
      <div className="fadeUp" style={{
        display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 12,
        marginBottom: 16, animationDelay: '0.04s',
      }}>
        <DateTile label="Posted" date={app.postedDate} />
        <DateTile label="Last date to apply" date={app.lastDate} accent />
        <DateTile label={app.status === 'saved' ? 'Saved on' : 'Applied on'} date={app.appliedAt || app.savedAt} />
      </div>

      {/* Next step */}
      <div className="fadeUp" style={{
        padding: 22, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 14, marginBottom: 16, animationDelay: '0.06s',
      }}>
        <div style={{
          fontFamily: fontDisplay, fontSize: 16, fontWeight: 700, color: S.ink,
          marginBottom: 12, letterSpacing: '-0.015em',
