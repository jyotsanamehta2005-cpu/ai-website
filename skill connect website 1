function CompaniesSection({ draft, update }) {
  const [editing, setEditing] = useState(null);
  const [search, setSearch]   = useState('');
  const [fetchToast, setFetchToast] = useState(null);
  const companies = draft.companies || [];
  const jobs = draft.jobs || [];

  const filtered = useMemo(() => {
    if (!search) return companies;
    const q = search.toLowerCase();
    return companies.filter(c =>
      c.name.toLowerCase().includes(q) ||
      c.industry?.toLowerCase().includes(q) ||
      c.location?.toLowerCase().includes(q));
  }, [companies, search]);

  const [pastingFor, setPastingFor] = useState(null);  // company id whose modal is open
  const [pastedText, setPastedText] = useState('');
  const [pasting, setPasting] = useState(false);

  const jobCountFor = (companyId) => jobs.filter(j => j.companyId === companyId).length;

  const addCompany = () => {
    const id = `co_${Date.now()}`;
    const next = [...companies, {
      id, name: 'New Company', logo: '🏢', initials: 'NC',
      industry: '', size: '', location: '', website: '', careersUrl: '',
      description: '', jobsCount: 0, verified: false,
    }];
    update('companies', next);
    setEditing(id);
  };
  const removeCompany = (id) => {
    if (!confirm('Delete this company? All its data and jobs will be lost.')) return;
    update('companies', companies.filter(c => c.id !== id));
    update('jobs', jobs.filter(j => j.companyId !== id));
    if (editing === id) setEditing(null);
  };
  const updateCompany = (id, patch) => {
    update('companies', companies.map(c => c.id === id ? { ...c, ...patch } : c));
  };

  const showFetchToast = (msg, kind = 'ok') => {
    setFetchToast({ msg, kind });
    setTimeout(() => setFetchToast(null), 4000);
  };

  const handleExtractFromText = async () => {
    const company = companies.find(c => c.id === pastingFor);
    if (!company) return;
    if (!pastedText || pastedText.trim().length < 30) {
      return showFetchToast('Please paste a longer job listing.', 'err');
    }
    setPasting(true);
    try {
      const { jobs: newJobs, error } = await extractJobFromText(pastedText, company);
      if (error) {
        showFetchToast(error, 'err');
        setPasting(false); return;
      }
      if (newJobs.length === 0) {
        showFetchToast(`Could not find a job in that text.`, 'err');
        setPasting(false); return;
      }
      update('jobs', [...jobs, ...newJobs]);
      updateCompany(company.id, { jobsCount: jobCountFor(company.id) + newJobs.length });
      showFetchToast(`✓ Added ${newJobs.length} job${newJobs.length !== 1 ? 's' : ''} to ${company.name}`);
      setPastingFor(null); setPastedText('');
    } catch (e) {
      showFetchToast('Extraction failed. Please try again.', 'err');
    }
    setPasting(false);
  };

  const editingCo = companies.find(c => c.id === editing);

  return (
    <>
      {fetchToast && (
