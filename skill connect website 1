        </div>
      </div>

      {/* Deadline */}
      {app.lastDate && (
        <div style={{
          padding: '4px 10px',
          background: isUrgent ? '#FEF3C7' : S.bgSoft,
          color: isUrgent ? '#92400E' : S.muted,
          borderRadius: 100, fontSize: 11, fontWeight: 700,
          whiteSpace: 'nowrap',
        }}>
          {isUrgent ? '⏰ ' : ''}{fmtRelativeDate(app.lastDate)}
        </div>
      )}

      {/* Status dropdown */}
      <select value={app.status}
        onClick={e => e.stopPropagation()}
        onChange={e => onStatusChange(e.target.value)}
        style={{
          padding: '6px 10px',
          background: meta.bg, color: meta.color,
          border: `1.5px solid ${meta.color}33`,
          borderRadius: 100, fontSize: 11, fontWeight: 700,
          fontFamily: fontBody, cursor: 'pointer',
          appearance: 'none', WebkitAppearance: 'none',
          paddingRight: 22, minWidth: 110,
          backgroundImage: `url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%23${meta.color.slice(1)}' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E")`,
          backgroundRepeat: 'no-repeat',
          backgroundPosition: 'right 8px center',
        }}>
        {APP_STATUSES.map(s => (
          <option key={s.k} value={s.k}>{s.label}</option>
        ))}
      </select>
    </div>
  );
}

