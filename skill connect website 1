function BrowseJobs({ user, settings, onUpload, onUpdateUser }) {
  const jobs = settings.jobs || [];
  const [selectedJobId, setSelectedJobId] = useState(null);
  const [search, setSearch]   = useState('');
  const [filterCo, setFilterCo] = useState('all');
  const [filterLoc, setFilterLoc] = useState('all');
  const [filterType, setFilterType] = useState('all');
  const [showTailor, setShowTailor] = useState(false);
  const [matching, setMatching]   = useState(false);
  const [matchStage, setMatchStage] = useState('');
  const [matchMap, setMatchMap]   = useState(null); // jobId -> { score, tier, whyItFits, missing }
  const [matchMode, setMatchMode] = useState(false); // toggle: show matched ranking vs default
  const [matchError, setMatchError] = useState('');

  const selectedJob = jobs.find(j => j.id === selectedJobId);
  const hasResume = !!user.profile;

  const resumeText = useMemo(() => {
    if (user.rawResume && !user.rawResume.startsWith('[PDF:')) return user.rawResume;
    return profileToText(user.profile);
  }, [user]);

  const handleMatchJobs = async () => {
    if (!hasResume) return setMatchError('Upload your résumé first to match jobs.');
    if (jobs.length === 0) return setMatchError('No jobs in the system yet.');
    setMatchError(''); setMatching(true);
    try {
      setMatchStage('Reading your résumé');
      await new Promise(r => setTimeout(r, 300));
      setMatchStage(`Matching against ${jobs.length} jobs`);
      const matches = await matchJobsToResume(resumeText, jobs);
      const map = {};
      matches.forEach(m => {
        const job = jobs[m.idx];
        if (job) map[job.id] = m;
      });
      setMatchMap(map);
      setMatchMode(true);
    } catch (e) {
      setMatchError('Could not match jobs. Please try again.');
    }
    setMatching(false);
  };

  const companies = useMemo(() => {
    const set = new Set(jobs.map(j => j.companyId));
    return Array.from(set).map(id => settings.companies.find(c => c.id === id)).filter(Boolean);
  }, [jobs, settings.companies]);

  const locations = useMemo(() => {
    const set = new Set(jobs.map(j => j.location).filter(Boolean));
    return Array.from(set).sort();
  }, [jobs]);

  const types = useMemo(() => {
    const set = new Set(jobs.map(j => j.type).filter(Boolean));
    return Array.from(set).sort();
  }, [jobs]);

  const filtered = useMemo(() => {
    let arr = jobs.filter(j => {
      if (filterCo !== 'all' && j.companyId !== filterCo) return false;
      if (filterLoc !== 'all' && j.location !== filterLoc) return false;
      if (filterType !== 'all' && j.type !== filterType) return false;
      if (search) {
        const q = search.toLowerCase();
        const hay = `${j.title} ${j.role} ${j.companyName} ${j.location} ${j.description}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });
    if (matchMode && matchMap) {
      arr = arr
        .map(j => ({ job: j, match: matchMap[j.id] }))
        .filter(x => x.match)
        .sort((a, b) => (b.match.score || 0) - (a.match.score || 0))
        .map(x => x.job);
    }
    return arr;
  }, [jobs, search, filterCo, filterLoc, filterType, matchMode, matchMap]);

  // Application + save helpers
  const applications = user.applications || [];
  const findApp = (jobId) => applications.find(a => a.jobId === jobId);

  const saveJob = async (job) => {
    if (!onUpdateUser) return;
    if (findApp(job.id)) return; // already in list
    const app = createApplicationFromJob(job, 'saved');
    await onUpdateUser({ applications: [...applications, app] });
  };
  const unsaveJob = async (job) => {
    if (!onUpdateUser) return;
    const existing = findApp(job.id);
    if (!existing) return;
    // Only remove if it's still in 'saved' state
    if (existing.status === 'saved') {
      await onUpdateUser({ applications: applications.filter(a => a.id !== existing.id) });
    }
  };
  const recordApplied = async (job) => {
    if (!onUpdateUser) return;
    const existing = findApp(job.id);
    if (existing) {
      // bump to applied if currently saved
      if (existing.status === 'saved') {
        const now = new Date().toISOString();
        const next = applications.map(a => a.id === existing.id
          ? { ...a, status: 'applied', appliedAt: now,
              history: [...(a.history || []), { at: now, event: 'Marked as applied' }] }
          : a);
        await onUpdateUser({ applications: next });
      }
      return;
    }
    const app = createApplicationFromJob(job, 'applied');
    await onUpdateUser({ applications: [...applications, app] });
  };

  if (selectedJob) {
    return (
      <JobDetail
        job={selectedJob}
        match={matchMap ? matchMap[selectedJob.id] : null}
        user={user}
        settings={settings}
        isSaved={!!findApp(selectedJob.id)}
        savedStatus={findApp(selectedJob.id)?.status}
        onSave={() => saveJob(selectedJob)}
        onUnsave={() => unsaveJob(selectedJob)}
        onApplied={() => recordApplied(selectedJob)}
        onBack={() => { setSelectedJobId(null); setShowTailor(false); }}
        onUpload={onUpload}
      />
    );
  }

  return (
    <div className="fade" style={{ padding: 44, maxWidth: 1180, margin: '0 auto' }}>
      <div className="fadeUp" style={{ marginBottom: 18 }}>
        <h1 style={{
          fontFamily: fontDisplay, fontSize: 32, fontWeight: 700,
          color: S.ink, margin: '0 0 8px', letterSpacing: '-0.02em',
        }}>Browse Jobs</h1>
        <p style={{ fontSize: 15, color: S.muted, margin: 0 }}>
          {jobs.length === 0
            ? 'No jobs in the system yet. An admin needs to import jobs first.'
            : matchMode && matchMap
              ? `Showing ${filtered.length} jobs ranked by fit with your résumé.`
              : `${filtered.length} of ${jobs.length} ${jobs.length === 1 ? 'opening' : 'openings'} matching your filters.`}
        </p>
      </div>

      {/* MATCH CTA */}
      {jobs.length > 0 && hasResume && !matchMode && (
        <div className="fadeUp" style={{
          padding: 20,
          background: `linear-gradient(135deg, ${S.primary} 0%, ${S.primaryMid} 100%)`,
          borderRadius: 16, color: '#fff',
          display: 'flex', alignItems: 'center', gap: 18,
          marginBottom: 18, position: 'relative', overflow: 'hidden',
          animationDelay: '0.04s',
        }}>
          <div style={{
            position: 'absolute', right: -40, top: -40,
            width: 160, height: 160, borderRadius: '50%',
            background: 'rgba(255,255,255,0.08)',
          }} />
          <div style={{
            width: 48, height: 48, borderRadius: 12, flexShrink: 0,
            background: 'rgba(255,255,255,0.15)',
            display: 'flex', alignItems: 'center', justifyContent: 'center',
            fontSize: 22,
          }}>🎯</div>
          <div style={{ flex: 1, position: 'relative' }}>
            <div style={{
              fontFamily: fontDisplay, fontSize: 18, fontWeight: 700,
              margin: '0 0 3px', letterSpacing: '-0.01em',
            }}>Match jobs to your résumé</div>
            <div style={{ fontSize: 13, opacity: 0.85, lineHeight: 1.45 }}>
              Claude ranks all {jobs.length} jobs by fit with your skills and experience.
            </div>
          </div>
          <button onClick={handleMatchJobs} disabled={matching}
            style={{
              position: 'relative', flexShrink: 0,
              padding: '11px 20px', background: '#fff', color: S.primary,
              border: 'none', borderRadius: 100,
              fontSize: 13, fontWeight: 700, fontFamily: fontBody,
              cursor: matching ? 'wait' : 'pointer',
              boxShadow: '0 6px 18px rgba(0,0,0,0.12)',
              display: 'flex', alignItems: 'center', gap: 7,
            }}>
            ✨ {matching ? `${matchStage}…` : 'Match my résumé'}
          </button>
        </div>
      )}

      {/* MATCH STATUS BAR (when active) */}
      {matchMode && matchMap && (
        <div className="fadeUp" style={{
          padding: '12px 18px', marginBottom: 16,
          background: S.accentBg, borderRadius: 100,
          border: '1px solid #A7F3D0',
          display: 'flex', alignItems: 'center', gap: 12,
          fontSize: 13,
        }}>
          <span style={{ fontSize: 16 }}>✓</span>
          <span style={{ flex: 1, color: '#065F46', fontWeight: 600 }}>
            Ranked by résumé fit — best matches first.
          </span>
          <button onClick={handleMatchJobs} disabled={matching}
            style={{
              background: 'none', border: 'none', color: '#065F46',
              fontSize: 12, fontWeight: 700, padding: 0, cursor: 'pointer',
              fontFamily: fontBody, textDecoration: 'underline',
