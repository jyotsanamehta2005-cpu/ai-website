// ===========================================================================
// APP ROOT
// ===========================================================================
export default function App() {
  const [route, setRoute]       = useState('loading');
  const [settings, setSettings] = useState(DEFAULT_SETTINGS);
  const [user, setUser]         = useState(null);
  const [studentNav, setStudentNav] = useState('home');
  const [viewingPage, setViewingPage] = useState(null);

  useEffect(() => {
    (async () => {
      const s = await loadSettings();
      setSettings(s);
      const session = await getSession();
      if (session?.userType && session?.id) {
        const u = await getUser(session.userType, session.id);
        if (u) {
          setUser(u);
          setRoute(u.userType === 'student' ? 'student' : 'coming-soon');
          return;
        }
      }
      setRoute('login');
    })();
  }, []);

  const handleSaveSettings = async (newSettings) => {
    setSettings(newSettings);
    await saveSettingsToStorage(newSettings);
  };
  const handleResetSettings = async () => {
    await clearSettings();
    setSettings(DEFAULT_SETTINGS);
  };

  const handleLogin = (u) => {
    setUser(u);
    setStudentNav('home');
    setRoute(u.userType === 'student' ? 'student' : 'coming-soon');
  };

  const handleLogout = async () => {
    await clearSession();
    setUser(null);
    setRoute('login');
  };

  const handleSaveProfile = async (profile, rawResume) => {
    const updated = { ...user, profile, rawResume: rawResume ?? user.rawResume };
    await saveUser(updated);
    setUser(updated);
  };

  // Generic user updater — used by application tracker, saved jobs, etc.
  const handleUpdateUser = async (patch) => {
    const updated = { ...user, ...patch };
    await saveUser(updated);
    setUser(updated);
  };

  if (route === 'loading') {
    return (
      <div style={{
        minHeight: '100vh', background: '#F2F5F2',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
      }}>
        <div style={{
          width: 32, height: 32, border: '3px solid #E5EDE9',
          borderTopColor: '#0A352B', borderRadius: '50%',
          animation: 'spin 0.8s linear infinite',
        }} />
        <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
      </div>
    );
  }

  let body;
  if (route === 'admin') {
    body = (
      <AdminPanel
        settings={settings}
        onSave={handleSaveSettings}
        onExit={() => setRoute(user ? (user.userType === 'student' ? 'student' : 'coming-soon') : 'login')}
        onReset={handleResetSettings}
      />
    );
  } else if (route === 'coming-soon' && user) {
    body = <ComingSoon user={user} onLogout={handleLogout} settings={settings} />;
  } else if (route === 'student' && user) {
    body = (
      <StudentShell
        user={user}
        settings={settings}
        active={studentNav}
        onNav={(k) => setStudentNav(k)}
        onLogout={handleLogout}
      >
        {studentNav === 'home' && (
          <StudentDashboard
            user={user}
            settings={settings}
            onUpload={() => setStudentNav('upload')}
            onProfile={() => setStudentNav('profile')}
          />
        )}
        {studentNav === 'upload' && (
          <ResumeUpload
            user={user}
            onBack={() => setStudentNav('home')}
            onComplete={async (profile, rawText) => {
              await handleSaveProfile(profile, rawText);
              setStudentNav('profile');
            }}
            onError={(msg) => alert(msg)}
          />
        )}
        {studentNav === 'profile' && (
          user.profile ? (
            <StudentProfile
              user={user}
              onReupload={() => setStudentNav('upload')}
              onSave={handleSaveProfile}
            />
          ) : (
            <div style={{ padding: 44, textAlign: 'center' }}>
              <div style={{ fontSize: 14, color: '#6B7F7A', marginBottom: 16 }}>
                No profile yet — upload your résumé first.
              </div>
              <button onClick={() => setStudentNav('upload')} style={{
                padding: '11px 22px', background: '#0A352B', color: '#fff',
                border: 'none', borderRadius: 100, fontSize: 14, fontWeight: 700,
                cursor: 'pointer', fontFamily: fontBody,
              }}>Upload résumé →</button>
            </div>
          )
        )}
        {studentNav === 'ats' && (
          <AtsChecker
            user={user}
            onBack={() => setStudentNav('home')}
            onUpload={() => setStudentNav('upload')}
          />
        )}
        {studentNav === 'jobs' && (
          <BrowseJobs
            user={user}
            settings={settings}
            onUpload={() => setStudentNav('upload')}
            onUpdateUser={handleUpdateUser}
          />
        )}
        {studentNav === 'applications' && (
          <MyApplications
            user={user}
            settings={settings}
            onUpdateUser={handleUpdateUser}
            onBrowseJobs={() => setStudentNav('jobs')}
          />
        )}
        {studentNav === 'interviews' && (
          <AiInterview
            user={user}
            settings={settings}
            onBack={() => setStudentNav('home')}
            onUpload={() => setStudentNav('upload')}
          />
        )}
        {studentNav === 'aptitude' && (
          <AptitudeTest
            user={user}
            settings={settings}
            onBack={() => setStudentNav('home')}
          />
        )}
      </StudentShell>
    );
  } else {
    body = (
      <LoginPage
        settings={settings}
        onOpenAdmin={() => setRoute('admin')}
        onLogin={handleLogin}
        onViewPage={(p) => setViewingPage(p)}
      />
    );
  }

  return (
    <>
      <style>{`
        :root {
          --sc-font-body: '${settings.fonts.bodyFamily}', -apple-system, sans-serif;
          --sc-font-display: '${settings.fonts.displayFamily}', '${settings.fonts.bodyFamily}', sans-serif;
        }
      `}</style>
      <FontLoader
        bodyFamily={settings.fonts.bodyFamily}
        displayFamily={settings.fonts.displayFamily}
      />
      {body}
      {viewingPage && (
        <PageViewer page={viewingPage} onClose={() => setViewingPage(null)} settings={settings} />
      )}
    </>
  );
}

// ---------------------------------------------------------------------------
// PAGE VIEWER MODAL — renders admin-created pages
// ---------------------------------------------------------------------------
function PageViewer({ page, onClose, settings }) {
  return (
    <div onClick={onClose} style={{
      position: 'fixed', inset: 0, zIndex: 300,
      background: 'rgba(8, 35, 28, 0.6)',
      backdropFilter: 'blur(8px)',
      display: 'flex', alignItems: 'center', justifyContent: 'center',
      padding: 24, fontFamily: fontBody,
      animation: 'fadeIn 0.25s ease both',
    }}>
      <style>{`@keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
                @keyframes popIn { from { opacity:0; transform: scale(0.96) translateY(8px); } to { opacity:1; transform: scale(1) translateY(0); } }`}</style>
      <div onClick={e => e.stopPropagation()} style={{
        maxWidth: 720, width: '100%', maxHeight: '85vh', overflow: 'auto',
        background: '#fff', borderRadius: 20, padding: 48,
        boxShadow: '0 40px 80px rgba(0,0,0,0.3)',
        animation: 'popIn 0.3s cubic-bezier(0.16,1,0.3,1) both',
        position: 'relative',
      }}>
        <button onClick={onClose} style={{
          position: 'absolute', top: 16, right: 16,
          width: 36, height: 36, borderRadius: '50%',
          background: '#F7FAF9', border: `1px solid #E5EDE9`,
          fontSize: 16, color: '#6B7F7A', cursor: 'pointer',
        }}>×</button>

        <div style={{
          fontSize: 11, fontWeight: 700, color: settings.colors.link,
          letterSpacing: '0.18em', marginBottom: 12,
        }}>{settings.brand.name.toUpperCase()}</div>
        <h1 style={{
          fontFamily: fontDisplay,
          fontSize: 34, fontWeight: 700, color: '#08231C',
          margin: '0 0 8px', letterSpacing: '-0.02em', lineHeight: 1.1,
        }}>{page.title}</h1>
        {page.subtitle && (
          <p style={{
            fontSize: 16, color: '#6B7F7A', margin: '0 0 24px', lineHeight: 1.5,
          }}>{page.subtitle}</p>
        )}
        <div style={{
          fontSize: 15, color: '#1B3530', lineHeight: 1.7,
          whiteSpace: 'pre-wrap',
        }}>{page.content}</div>
      </div>
    </div>
  );
}
