async function fetchJobsFromAdzuna({ appId, appKey, query, location, country = 'in', maxResults = 20 }) {
  if (!appId || !appKey) {
    throw new Error('Missing Adzuna credentials. Add them in Admin → Job Sources.');
  }
  const params = new URLSearchParams({
    app_id: appId,
    app_key: appKey,
    results_per_page: String(Math.min(maxResults, 50)),
    'content-type': 'application/json',
  });
  if (query)    params.set('what', query);
  if (location) params.set('where', location);

  const url = `https://api.adzuna.com/v1/api/jobs/${country}/search/1?${params}`;
  const res = await fetch(url);
  if (!res.ok) {
    const body = await res.text().catch(() => '');
    throw new Error(`Adzuna error ${res.status}${body ? ': ' + body.slice(0, 120) : ''}`);
  }
  const data = await res.json();
  const results = data.results || [];
  if (results.length === 0) {
    return { jobs: [], error: 'No jobs returned for that search.' };
  }
  const now = new Date().toISOString();
  return {
    jobs: results.map((r, idx) => {
      // Derive a stable company record from the result
      const companyName = r.company?.display_name || 'Unknown';
      const companyId = 'adz_' + companyName.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 20);
      // Guess job type from contract_type / contract_time
      let type = 'Full-time';
      const ct = (r.contract_type || '').toLowerCase();
      const ctime = (r.contract_time || '').toLowerCase();
      if (ct.includes('contract')) type = 'Contract';
      else if (ctime.includes('part')) type = 'Part-time';
      else if (r.category?.label?.toLowerCase().includes('intern')) type = 'Internship';
      return {
        id: `job_adz_${r.id || Date.now()}_${idx}`,
        companyId,
        companyName,
        companyLogo: '🏢',
        title: r.title || 'Untitled Role',
        role: r.category?.label || '',
        location: r.location?.display_name || '',
        type,
        experience: '',
        description: (r.description || '').slice(0, 600),
        requirements: [],
        applyUrl: r.redirect_url || '',
        postedDate: r.created ? r.created.slice(0, 10) : '',
        lastDate: '',
        fetchedAt: now,
        source: 'adzuna',
        saved: false,
      };
    }),
    error: '',
  };
}

