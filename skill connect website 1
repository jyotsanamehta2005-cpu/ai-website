function AtsChecker({ user, onBack, onUpload }) {
  const [jd, setJd] = useState('');
  const [showJd, setShowJd] = useState(false);
  const [loading, setLoading] = useState(false);
  const [stage, setStage] = useState('');
  const [result, setResult] = useState(null);
  const [error, setError] = useState('');
  const [improving, setImproving] = useState(false);
  const [improveStage, setImproveStage] = useState('');
  const [improved, setImproved] = useState(null);
  const [improveError, setImproveError] = useState('');

  const hasResume = !!user.profile;
  const resumeName = user.profile?.name || 'Your résumé';

  const resumeText = useMemo(() => {
    if (user.rawResume && !user.rawResume.startsWith('[PDF:')) return user.rawResume;
    return profileToText(user.profile);
  }, [user]);

  const handleAnalyze = async () => {
    if (!hasResume) return setError('Upload your résumé first.');
    setError(''); setResult(null); setImproved(null); setLoading(true);
    try {
      setStage('Scanning your résumé');
      await new Promise(r => setTimeout(r, 400));
      setStage('Running ATS checks');
      const res = await atsAnalyze(resumeText, showJd ? jd : '');
      setStage('Building your report');
      await new Promise(r => setTimeout(r, 300));
      setResult(res);
    } catch (e) {
      setError('Analysis failed. Please try again.');
    }
    setLoading(false);
  };

  const handleImprove = async () => {
    if (!result?.improvements?.length) return;
    setImproveError(''); setImproved(null); setImproving(true);
    try {
      setImproveStage('Reading your improvements');
      await new Promise(r => setTimeout(r, 400));
      setImproveStage('Rewriting your résumé');
      const newProfile = await improveResume(resumeText, result.improvements);
      setImproveStage('Polishing the final draft');
      await new Promise(r => setTimeout(r, 300));
      setImproved(newProfile);
    } catch (e) {
      setImproveError('Could not rewrite the résumé. Please try again.');
    }
    setImproving(false);
  };

  return (
    <div className="fade" style={{ padding: 44, maxWidth: 1060, margin: '0 auto' }}>
      <button onClick={onBack} style={{
        background: 'none', border: 'none', fontSize: 13, fontWeight: 600,
        color: S.muted, padding: 0, marginBottom: 22, cursor: 'pointer',
        fontFamily: fontBody,
      }}>← Back to dashboard</button>

      <div className="fadeUp" style={{ marginBottom: 28 }}>
        <div style={{
          display: 'inline-block', padding: '4px 12px',
          background: S.bgTint, color: S.primary,
          borderRadius: 100, fontSize: 11, fontWeight: 700,
          letterSpacing: '0.08em', marginBottom: 14,
        }}>STEP 02 · ATS CHECK</div>
        <h1 style={{
          fontFamily: fontDisplay,
          fontSize: 34, fontWeight: 700, color: S.ink,
          margin: '0 0 10px', letterSpacing: '-0.02em', lineHeight: 1.1,
        }}>Beat the bots</h1>
        <p style={{
          fontSize: 16, color: S.muted, margin: 0,
          maxWidth: 600, lineHeight: 1.5,
        }}>Get your résumé past automated screeners. We score structure, content,
          keywords, and impact — plus optional job-description matching for keyword fit.</p>
      </div>

      {!hasResume && (
        <div className="fadeUp" style={{
          padding: 32, background: S.bgSoft, borderRadius: 16,
          border: `1px solid ${S.line}`, textAlign: 'center', marginBottom: 22,
        }}>
          <div style={{ fontSize: 36, marginBottom: 12 }}>📄</div>
          <div style={{
            fontFamily: fontDisplay, fontSize: 18, fontWeight: 700, color: S.ink,
