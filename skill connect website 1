function gradeAptitudeTest({ preset, questions, answers, timePerQuestion, totalTimeSec }) {
  const total = questions.length;
  let correct = 0, attempted = 0;

  // Section-wise tally
  const bySection = {};
  preset.sections.forEach(s => {
    bySection[s.name] = { total: 0, correct: 0, attempted: 0 };
  });

  // Topic-wise weakness tracking
  const topicMisses = {};

  const details = questions.map((q, i) => {
    const selected = answers[i];
    const isAttempted = selected !== null && selected !== undefined;
    const isCorrect = isAttempted && selected === q.correctIndex;
    if (isAttempted) attempted++;
    if (isCorrect) correct++;

    if (bySection[q.section]) {
      bySection[q.section].total++;
      if (isAttempted) bySection[q.section].attempted++;
      if (isCorrect) bySection[q.section].correct++;
    }

    if (isAttempted && !isCorrect) {
      topicMisses[q.topic || 'General'] = (topicMisses[q.topic || 'General'] || 0) + 1;
    }

    return {
      id: q.id,
      section: q.section,
      question: q.question,
      options: q.options,
      correctIndex: q.correctIndex,
      explanation: q.explanation,
      topic: q.topic,
      difficulty: q.difficulty,
      selected: selected ?? null,
      isAttempted, isCorrect,
      timeSec: timePerQuestion[i] || 0,
    };
  });

  const accuracy = attempted ? Math.round((correct / attempted) * 100) : 0;
  const score = Math.round((correct / total) * 100);

  const weakTopics = Object.entries(topicMisses)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([topic, count]) => ({ topic, missCount: count }));

  return {
    totalQuestions: total,
    correct, attempted, unattempted: total - attempted,
    incorrect: attempted - correct,
    score, accuracy,
    bySection: Object.entries(bySection).map(([name, v]) => ({
      name,
      score: v.total ? Math.round((v.correct / v.total) * 100) : 0,
      ...v,
    })),
    weakTopics,
    totalTimeSec,
    avgTimePerQuestion: total ? Math.round(totalTimeSec / total) : 0,
    details,
  };
}

