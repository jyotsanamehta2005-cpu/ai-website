function JobSourcesSection({ draft, update }) {
  const adz = draft.jobSources?.adzuna || { enabled: false, appId: '', appKey: '', defaultCountry: 'in' };
  const [query, setQuery]       = useState('');
  const [location, setLocation] = useState('');
  const [importing, setImporting] = useState(false);
  const [toast, setToast]       = useState(null);

  // Indeed-via-Claude flow
  const [indeedQuery, setIndeedQuery] = useState('software engineer intern');
  const [indeedLoc, setIndeedLoc]     = useState('Gurugram, Haryana');
  const [indeedCountry, setIndeedCountry] = useState('IN');
  const [indeedJson, setIndeedJson]   = useState('');
  const [indeedImporting, setIndeedImporting] = useState(false);

  const showToast = (msg, kind = 'ok') => {
    setToast({ msg, kind });
    setTimeout(() => setToast(null), 4000);
  };

  const indeedPrompt = `Run Indeed:search_jobs with:
- country_code: ${indeedCountry}
- location: ${indeedLoc}
- search: ${indeedQuery}

Then for EACH job returned, call Indeed:get_job_details with that job's Job Id to fetch the full description and requirements.

After all detail calls are done, return ONLY a JSON array of jobs in this exact shape (no markdown fences, no commentary):

[
  {
    "title": "...",
    "companyName": "...",
    "location": "...",
    "type": "Internship | Full-time | Part-time | Contract | Other",
    "experience": "extracted from the details if mentioned, else empty",
    "postedDate": "YYYY-MM-DD",
    "applyUrl": "https://...",
    "description": "2-4 sentence summary of what the role involves, based on the get_job_details response",
    "requirements": ["3-6 key requirements / must-haves from the details, as short bullet strings"]
  }
]

Rules:
- type mapping: "Internship" -> "Internship", "Part-time" -> "Part-time", "Full-time" -> "Full-time", "Fresher" -> "Full-time", "Contract" -> "Contract", anything else -> "Other"
- postedDate format: "May 06, 2026" -> "2026-05-06"
- description: write a clean 2-4 sentence summary, NOT the entire JD. Focus on what they'll do.
- requirements: extract the top 3-6 must-haves (skills, qualifications, experience level) as concise bullet strings
- If get_job_details fails for a job, still include it with description="" and requirements=[]
- Do not include jobs you couldn't get any data for at all`;

  const copyIndeedPrompt = async () => {
    try {
      await navigator.clipboard.writeText(indeedPrompt);
      showToast('✓ Prompt copied — paste it into your Claude chat');
    } catch (e) {
      showToast('Could not copy. Select the text manually.', 'err');
    }
  };

  const handleIndeedImport = () => {
    if (!indeedJson.trim()) return showToast('Paste the JSON array Claude returned.', 'err');
    let parsed;
    try {
      // Try to extract JSON array even if wrapped in fences/text
      let cleaned = indeedJson.trim()
        .replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/```$/, '').trim();
      const first = cleaned.indexOf('[');
      const last  = cleaned.lastIndexOf(']');
      if (first >= 0 && last > first) cleaned = cleaned.slice(first, last + 1);
      parsed = JSON.parse(cleaned);
    } catch (e) {
      return showToast('That doesn\'t look like valid JSON. Make sure you copied the array Claude returned.', 'err');
    }
    if (!Array.isArray(parsed) || parsed.length === 0) {
      return showToast('Expected a non-empty JSON array.', 'err');
    }

    setIndeedImporting(true);
    const companies = draft.companies || [];
    const existing = new Map(companies.map(c => [c.id, c]));
    const newCompanies = [];
    const now = new Date().toISOString();

    const newJobs = parsed.map((j, idx) => {
      const companyName = j.companyName || j.company || 'Unknown';
      const companyId = 'idd_' + companyName.toLowerCase().replace(/[^a-z0-9]/g, '').slice(0, 24);
      if (!existing.has(companyId)) {
        const co = {
          id: companyId,
          name: companyName,
          logo: '🏢',
          initials: companyName.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase(),
          industry: '', size: '', location: j.location || '',
          website: '', careersUrl: '',
          description: '', jobsCount: 0, verified: false,
          source: 'indeed',
        };
        newCompanies.push(co);
        existing.set(companyId, co);
      }
      return {
        id: `job_idd_${Date.now()}_${idx}`,
        companyId,
        companyName,
        companyLogo: '🏢',
        title: j.title || 'Untitled Role',
        role: '',
        location: j.location || '',
        type: j.type || 'Full-time',
        experience: j.experience || '',
        description: j.description || '',
        requirements: Array.isArray(j.requirements) ? j.requirements : [],
        applyUrl: j.applyUrl || '',
        postedDate: j.postedDate || '',
        lastDate: '',
        fetchedAt: now,
        source: 'indeed',
        saved: false,
      };
    });

    const allJobs = [...(draft.jobs || []), ...newJobs];
    const mergedCompanies = [...companies, ...newCompanies].map(c => ({
      ...c, jobsCount: allJobs.filter(j => j.companyId === c.id).length,
    }));

    update('jobs', allJobs);
    update('companies', mergedCompanies);
    setIndeedJson('');
    showToast(`✓ Imported ${newJobs.length} jobs from Indeed (${newCompanies.length} new companies)`);
    setIndeedImporting(false);
  };

  const handleImport = async () => {
    if (!adz.appId || !adz.appKey) {
      return showToast('Add your Adzuna App ID and Key first.', 'err');
    }
    if (!query.trim()) {
      return showToast('Enter a search query — e.g. "software intern".', 'err');
    }
    setImporting(true);
    try {
      const { jobs: newJobs, error } = await fetchJobsFromAdzuna({
        appId: adz.appId, appKey: adz.appKey,
        query, location,
        country: adz.defaultCountry || 'in',
        maxResults: 25,
      });
      if (error) { showToast(error, 'err'); setImporting(false); return; }
      if (!newJobs.length) {
        showToast('No jobs returned for that query.', 'err');
        setImporting(false); return;
      }

      // Auto-create company records for any company we don't already have
      const companies = draft.companies || [];
      const existing = new Map(companies.map(c => [c.id, c]));
      const newCompanies = [];
      newJobs.forEach(j => {
        if (!existing.has(j.companyId)) {
          const co = {
            id: j.companyId,
            name: j.companyName,
            logo: '🏢',
            initials: j.companyName.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase(),
            industry: '', size: '', location: j.location || '',
            website: '', careersUrl: '',
            description: '',
            jobsCount: 0,
            verified: false,
            source: 'adzuna',
          };
          newCompanies.push(co);
          existing.set(co.id, co);
        }
      });

      // Merge jobs (dedupe by id), update companies
      const allJobs = [...(draft.jobs || [])];
      newJobs.forEach(j => {
        if (!allJobs.find(existing => existing.id === j.id)) allJobs.push(j);
      });
      const mergedCompanies = [...companies, ...newCompanies].map(c => ({
        ...c,
        jobsCount: allJobs.filter(j => j.companyId === c.id).length,
      }));

      update('jobs', allJobs);
      update('companies', mergedCompanies);
      showToast(`✓ Imported ${newJobs.length} jobs (${newCompanies.length} new companies)`);
    } catch (e) {
      showToast(e?.message || 'Import failed.', 'err');
    }
    setImporting(false);
  };

  return (
    <>
      {toast && (
        <div style={{
          position: 'fixed', top: 24, right: 24, zIndex: 300,
          padding: '13px 22px',
          background: toast.kind === 'err' ? '#DC2626' : A.forest,
          color: '#fff', borderRadius: 11, fontSize: 13, fontWeight: 600,
          boxShadow: '0 18px 40px rgba(0,0,0,0.18)',
          maxWidth: 420, fontFamily: fontBody,
          animation: 'fadeUp 0.3s ease both',
        }}>{toast.msg}</div>
      )}

      <SectionHeader
        title="Job Sources"
        description="Connect external job APIs or fetch jobs through Claude to bulk-import real listings."
      />

      <Card title="Indeed (via Claude chat)">
        <div style={{
          padding: 14, marginBottom: 18,
          background: A.accent + '15', borderRadius: 10,
          fontSize: 12.5, color: A.text, lineHeight: 1.55,
          border: `1px solid ${A.accent}33`,
        }}>
          <strong>How this works:</strong> Indeed access lives in your Claude chat, not in your website.
          Set your search below → copy the prompt → paste it to Claude in chat →
          Claude returns a JSON array → paste it back here → import. ~30 seconds end-to-end.
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '2fr 2fr 1fr', gap: 12 }}>
          <TextInput label="Search (role / keywords)"
            value={indeedQuery} onChange={setIndeedQuery}
            placeholder="e.g. software engineer intern" />
          <TextInput label="Location"
            value={indeedLoc} onChange={setIndeedLoc}
            placeholder="e.g. Bengaluru, Karnataka" />
          <div>
            <label style={{
              display: 'block', marginBottom: 6, fontSize: 12, fontWeight: 700,
              color: A.text, letterSpacing: '0.02em',
            }}>Country</label>
            <select value={indeedCountry}
              onChange={e => setIndeedCountry(e.target.value)}
              style={{ ...adminInputStyle, cursor: 'pointer' }}>
              <option value="IN">IN · India</option>
              <option value="US">US</option>
              <option value="GB">GB · UK</option>
              <option value="CA">CA</option>
              <option value="AU">AU</option>
              <option value="SG">SG</option>
              <option value="AE">AE</option>
            </select>
          </div>
        </div>

        <div style={{
          fontSize: 11, fontWeight: 700, color: A.muted,
          letterSpacing: '0.08em', marginTop: 14, marginBottom: 8,
        }}>STEP 1 · COPY THIS PROMPT</div>
        <div style={{
          position: 'relative', padding: 14,
          background: A.bg, border: `1.5px solid ${A.line}`, borderRadius: 10,
          fontFamily: 'monospace', fontSize: 12, color: A.text,
          lineHeight: 1.55, whiteSpace: 'pre-wrap', wordBreak: 'break-word',
          maxHeight: 160, overflow: 'auto',
        }}>
          {indeedPrompt}
          <button onClick={copyIndeedPrompt} style={{
            position: 'absolute', top: 8, right: 8,
            padding: '6px 12px', background: A.forest, color: '#fff',
            border: 'none', borderRadius: 7,
            fontSize: 11, fontWeight: 700, cursor: 'pointer', fontFamily: fontBody,
          }}>Copy</button>
        </div>

        <div style={{
          fontSize: 11, fontWeight: 700, color: A.muted,
          letterSpacing: '0.08em', marginTop: 18, marginBottom: 8,
        }}>STEP 2 · PASTE CLAUDE'S JSON ARRAY HERE</div>
        <textarea
          value={indeedJson}
          onChange={e => setIndeedJson(e.target.value)}
          placeholder={`[\n  {\n    "title": "Software Engineer Intern",\n    "companyName": "...",\n    ...\n  }\n]`}
          rows={6}
          style={{
            width: '100%', padding: 14,
            border: `1.5px solid ${A.line}`, borderRadius: 10,
            background: A.bg, fontSize: 12, color: A.ink,
            fontFamily: 'monospace', lineHeight: 1.5,
            resize: 'vertical',
          }}
        />

        <button onClick={handleIndeedImport} disabled={indeedImporting || !indeedJson.trim()}
          style={{
            marginTop: 12, padding: '11px 22px',
            background: indeedImporting || !indeedJson.trim() ? A.lineSoft : A.forest,
            color: indeedImporting || !indeedJson.trim() ? A.muted : '#fff',
            border: 'none', borderRadius: 100,
            fontSize: 13, fontWeight: 700, fontFamily: fontBody,
            cursor: indeedImporting || !indeedJson.trim() ? 'not-allowed' : 'pointer',
            display: 'inline-flex', alignItems: 'center', gap: 8,
          }}>
          📥 {indeedImporting ? 'Importing…' : 'Import Indeed jobs'}
        </button>
      </Card>

      <Card title="Adzuna API"
        action={
          <button onClick={() => update('jobSources.adzuna.enabled', !adz.enabled)}
            style={{
              padding: '7px 12px',
              background: adz.enabled ? A.accent + '22' : A.bg,
              color: adz.enabled ? '#065F46' : A.muted,
              border: `1px solid ${adz.enabled ? A.accent + '44' : A.line}`,
              borderRadius: 8, fontSize: 11, fontWeight: 700,
              cursor: 'pointer', fontFamily: fontBody,
            }}>{adz.enabled ? 'ENABLED' : 'DISABLED'}</button>
        }>
        <div style={{
          padding: 14, marginBottom: 18,
          background: '#FEF3C7', borderRadius: 10,
          fontSize: 12.5, color: '#92400E', lineHeight: 1.55,
        }}>
          <strong>How to get free Adzuna API keys (2 min):</strong>
          <ol style={{ margin: '6px 0 0 18px', padding: 0 }}>
            <li>Go to <a href="https://developer.adzuna.com/signup" target="_blank" rel="noopener noreferrer" style={{ color: '#92400E', fontWeight: 700 }}>developer.adzuna.com/signup</a></li>
            <li>Create a free account — they email an <strong>App ID</strong> and <strong>App Key</strong></li>
            <li>Paste them below — that's it. Free tier allows 1,000 calls / month.</li>
          </ol>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
          <TextInput label="App ID" value={adz.appId}
            onChange={v => update('jobSources.adzuna.appId', v)}
            placeholder="e.g. a1b2c3d4" />
          <TextInput label="App Key" value={adz.appKey}
            onChange={v => update('jobSources.adzuna.appKey', v)}
            placeholder="long alphanumeric string" />
        </div>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr', gap: 12 }}>
          <div>
            <label style={{
              display: 'block', marginBottom: 6, fontSize: 12, fontWeight: 700,
              color: A.text, letterSpacing: '0.02em',
            }}>Country</label>
            <select value={adz.defaultCountry || 'in'}
              onChange={e => update('jobSources.adzuna.defaultCountry', e.target.value)}
              style={{ ...adminInputStyle, cursor: 'pointer' }}>
              <option value="in">India (in)</option>
              <option value="us">United States (us)</option>
              <option value="gb">United Kingdom (gb)</option>
              <option value="ca">Canada (ca)</option>
              <option value="au">Australia (au)</option>
              <option value="sg">Singapore (sg)</option>
              <option value="ae">UAE (ae)</option>
            </select>
          </div>
        </div>
      </Card>

      <Card title="Import jobs from Adzuna">
        <p style={{ fontSize: 13, color: A.muted, margin: '0 0 14px', lineHeight: 1.55 }}>
          Search Adzuna's database and import matching jobs in one click.
          Companies you don't already have will be auto-created.
        </p>
        <div style={{ display: 'grid', gridTemplateColumns: '2fr 1fr', gap: 12 }}>
          <TextInput label="Search query (role / keywords)"
            value={query} onChange={setQuery}
            placeholder="e.g. software engineer intern" />
          <TextInput label="Location (optional)"
            value={location} onChange={setLocation}
            placeholder="e.g. Bengaluru" />
        </div>
        <button onClick={handleImport} disabled={importing || !adz.appId || !adz.appKey}
          style={{
            padding: '11px 22px',
            background: importing || !adz.appId || !adz.appKey ? A.lineSoft : A.forest,
            color: importing || !adz.appId || !adz.appKey ? A.muted : '#fff',
            border: 'none', borderRadius: 100,
            fontSize: 13, fontWeight: 700, fontFamily: fontBody,
            cursor: importing || !adz.appId || !adz.appKey ? 'not-allowed' : 'pointer',
            display: 'inline-flex', alignItems: 'center', gap: 8,
            marginTop: 8,
          }}>
          🛰️ {importing ? 'Importing jobs…' : 'Import jobs from Adzuna'}
        </button>
      </Card>

      <Card title="Manual paste (always works)">
        <p style={{ fontSize: 13, color: A.muted, margin: 0, lineHeight: 1.55 }}>
          For any company on the Companies page, hit <strong>✨ Add a job from text</strong> and paste a listing
          from anywhere. Claude extracts the structure. Use this for jobs from sources Adzuna doesn't cover —
          Naukri, TimesJobs, LinkedIn, internal company portals.
        </p>
      </Card>
    </>
  );
}

