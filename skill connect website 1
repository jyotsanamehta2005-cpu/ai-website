        <div style={{ display: 'grid', gridTemplateColumns: '2fr 1fr', gap: 10 }}>
          <input value={nextStep} onChange={e => setNextStep(e.target.value)}
            onBlur={saveDirty}
            placeholder="e.g. Online test on company portal, prep DSA"
            style={{
              padding: '10px 14px',
              border: `1.5px solid ${S.line}`, borderRadius: 9,
              fontSize: 14, color: S.ink, fontFamily: fontBody, background: S.bg,
            }} />
          <input type="date" value={nextStepDate} onChange={e => setNextStepDate(e.target.value)}
            onBlur={saveDirty}
            style={{
              padding: '10px 14px',
              border: `1.5px solid ${S.line}`, borderRadius: 9,
              fontSize: 14, color: S.ink, fontFamily: fontBody, background: S.bg,
            }} />
        </div>
      </div>

      {/* Notes */}
      <div className="fadeUp" style={{
        padding: 22, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 14, marginBottom: 16, animationDelay: '0.08s',
      }}>
        <div style={{
          fontFamily: fontDisplay, fontSize: 16, fontWeight: 700, color: S.ink,
          marginBottom: 10, letterSpacing: '-0.015em',
        }}>📝 Notes</div>
        <textarea value={notes} onChange={e => setNotes(e.target.value)}
          onBlur={saveDirty}
          placeholder="Recruiter contact, salary expectations, interview prep notes…"
          style={{
            width: '100%', minHeight: 100, padding: 12,
            border: `1.5px solid ${S.line}`, borderRadius: 9,
            fontSize: 13.5, color: S.ink, fontFamily: fontBody, background: S.bg,
            resize: 'vertical', lineHeight: 1.55,
          }} />
      </div>

      {/* Timeline */}
      <div className="fadeUp" style={{
        padding: 22, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 14, marginBottom: 16, animationDelay: '0.1s',
      }}>
        <div style={{
          fontFamily: fontDisplay, fontSize: 16, fontWeight: 700, color: S.ink,
          marginBottom: 14, letterSpacing: '-0.015em',
        }}>📜 Timeline</div>
        <div style={{ position: 'relative', paddingLeft: 18 }}>
          <div style={{
            position: 'absolute', left: 4, top: 6, bottom: 6,
            width: 2, background: S.line,
          }} />
          {(app.history || []).slice().reverse().map((h, i) => (
            <div key={i} style={{
              position: 'relative', paddingBottom: 14,
            }}>
              <div style={{
                position: 'absolute', left: -18, top: 4,
                width: 10, height: 10, borderRadius: '50%',
                background: i === 0 ? S.primary : S.bgTint,
                border: `2px solid ${i === 0 ? S.primary : S.line}`,
              }} />
              <div style={{ fontSize: 13, color: S.ink, fontWeight: 600 }}>{h.event}</div>
              <div style={{ fontSize: 11, color: S.muted, marginTop: 2 }}>
                {new Date(h.at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' })}
              </div>
            </div>
          ))}
        </div>
      </div>

