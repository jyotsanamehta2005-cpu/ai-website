function ResumeUpload({ user, onBack, onComplete, onError }) {
  const [mode, setMode] = useState('paste');
  const [text, setText] = useState(user.rawResume || '');
  const [fileName, setFileName] = useState('');
  const [fileSize, setFileSize] = useState(0);
  const [pdfBase64, setPdfBase64] = useState('');
  const [loading, setLoading] = useState(false);
  const [stage, setStage] = useState('Reading your résumé');
  const fileRef = useRef(null);

  const formatSize = (b) => b < 1024 ? `${b} B`
    : b < 1024 * 1024 ? `${(b / 1024).toFixed(1)} KB`
    : `${(b / 1024 / 1024).toFixed(2)} MB`;

  const handleFile = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setFileName(file.name);
    setFileSize(file.size);
    setPdfBase64('');
    const ext = file.name.split('.').pop().toLowerCase();
    try {
      if (ext === 'txt') {
        const t = await file.text();
        setText(t);
      } else if (ext === 'docx') {
        const mammoth = (await import('mammoth')).default;
        const arrayBuffer = await file.arrayBuffer();
        const result = await mammoth.extractRawText({ arrayBuffer });
        setText(result.value);
      } else if (ext === 'pdf') {
        if (file.size > 10 * 1024 * 1024) {
          onError('PDF is over 10 MB — please use a smaller file.');
          setFileName(''); setFileSize(0); return;
        }
        const b64 = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload  = () => resolve(reader.result.split(',')[1]);
          reader.onerror = () => reject(new Error('read failed'));
          reader.readAsDataURL(file);
        });
        setPdfBase64(b64);
        setText('');
      } else {
        onError('Unsupported file type. Use .pdf, .docx, .txt, or paste below.');
        setFileName(''); setFileSize(0);
      }
    } catch (err) {
      onError('Could not read that file. Try paste instead.');
      setFileName(''); setFileSize(0);
    }
  };

  const handleExtract = async () => {
    const hasText = text && text.trim().length >= 50;
    const hasPdf  = !!pdfBase64;
    if (!hasText && !hasPdf) {
      return onError('Please paste a résumé or upload a file.');
    }
    setLoading(true);
    try {
      setStage(hasPdf ? 'Reading your PDF' : 'Reading your résumé');
      await new Promise(r => setTimeout(r, 400));
      setStage('Extracting your details');
      const profile = hasPdf
        ? await extractResumeFromPdf(pdfBase64)
        : await extractResume(text);
      setStage('Building your profile');
      await new Promise(r => setTimeout(r, 400));
      onComplete(profile, hasPdf ? `[PDF: ${fileName}]` : text);
    } catch (err) {
      console.error(err);
      onError('Extraction failed. Please try again.');
      setLoading(false);
    }
  };

  const canExtract = (text && text.trim().length >= 50) || !!pdfBase64;

  if (loading) {
    return (
      <div className="fade" style={{
        minHeight: '100vh', display: 'flex', alignItems: 'center', justifyContent: 'center',
        flexDirection: 'column', gap: 26, padding: 44,
      }}>
        <div style={{ position: 'relative' }}>
          <div style={{
            width: 76, height: 76, border: `3px solid ${S.bgTint}`,
            borderTopColor: S.primary, borderRadius: '50%',
            animation: 'spin 1s linear infinite',
          }} />
          <div style={{
            position: 'absolute', inset: 0, display: 'flex',
            alignItems: 'center', justifyContent: 'center', fontSize: 26,
          }}>✨</div>
        </div>
        <div style={{ textAlign: 'center' }}>
          <div style={{
            fontFamily: fontDisplay,
            fontSize: 22, fontWeight: 700, color: S.ink,
            letterSpacing: '-0.015em', marginBottom: 8,
          }}>{stage}...</div>
          <div style={{
            fontSize: 12, color: S.muted, fontWeight: 600, letterSpacing: '0.08em',
          }}>CLAUDE IS WORKING ON IT</div>
        </div>
      </div>
    );
  }

  return (
    <div className="fade" style={{ padding: 44, maxWidth: 940, margin: '0 auto' }}>
      <button onClick={onBack} style={{
        background: 'none', border: 'none', fontSize: 13, fontWeight: 600,
        color: S.muted, padding: 0, marginBottom: 22, cursor: 'pointer',
      }}>← Back to dashboard</button>

      <div className="fadeUp">
        <div style={{
          display: 'inline-block', padding: '4px 12px',
          background: S.bgTint, color: S.primary,
          borderRadius: 100, fontSize: 11, fontWeight: 700,
          letterSpacing: '0.08em', marginBottom: 14,
        }}>STEP 01 · RÉSUMÉ INTAKE</div>
        <h1 style={{
          fontFamily: fontDisplay,
          fontSize: 34, fontWeight: 700, color: S.ink,
          margin: '0 0 10px', letterSpacing: '-0.02em', lineHeight: 1.1,
        }}>Drop your résumé</h1>
        <p style={{
          fontSize: 16, color: S.muted, margin: '0 0 28px',
          maxWidth: 560, lineHeight: 1.5,
        }}>Paste the text or upload a .docx / .txt file. Claude will extract
          every detail and build your profile.</p>
      </div>

      <div className="fadeUp" style={{
        display: 'inline-flex', gap: 5, padding: 5,
        background: S.bgSoft, borderRadius: 12, marginBottom: 18,
        animationDelay: '0.05s',
      }}>
        {[
          { k: 'paste', l: 'Paste text', i: '📝' },
          { k: 'file',  l: 'Upload file', i: '📎' },
        ].map(m => (
          <button key={m.k} onClick={() => setMode(m.k)} style={{
            padding: '9px 16px',
            background: mode === m.k ? S.bg : 'transparent',
            color: mode === m.k ? S.ink : S.muted,
            border: 'none', borderRadius: 8,
            fontSize: 13, fontWeight: 600, cursor: 'pointer',
            fontFamily: fontBody,
            boxShadow: mode === m.k ? '0 2px 8px rgba(0,0,0,0.05)' : 'none',
            display: 'flex', alignItems: 'center', gap: 7,
          }}><span>{m.i}</span>{m.l}</button>
        ))}
      </div>

      {mode === 'paste' && (
        <div className="fadeUp" style={{ animationDelay: '0.1s' }}>
          <textarea
            value={text}
            onChange={e => setText(e.target.value)}
            placeholder="Paste your résumé here — full text, line breaks and all..."
            style={{
              width: '100%', minHeight: 320, padding: 18,
              border: `1.5px solid ${S.line}`, borderRadius: 14,
              background: S.bg, fontSize: 14, lineHeight: 1.6,
              color: S.ink, resize: 'vertical', fontFamily: fontBody,
            }}
          />
          <div style={{
            marginTop: 10, fontSize: 12, color: S.muted,
            display: 'flex', justifyContent: 'space-between',
          }}>
            <span style={{ fontWeight: 600 }}>{text.length.toLocaleString()} characters</span>
            <span>💡 Tip: include Education, Experience, Skills sections</span>
          </div>
        </div>
      )}

      {mode === 'file' && (
        <div className="fadeUp" style={{ animationDelay: '0.1s' }}>
          <div
            onClick={() => fileRef.current?.click()}
            style={{
              border: `2px dashed ${pdfBase64 ? S.accent : S.line}`,
              borderRadius: 16, padding: 52,
              textAlign: 'center', background: pdfBase64 ? S.accentBg : S.bgSoft,
              cursor: 'pointer', transition: 'all 0.2s',
            }}
            onMouseOver={e => {
              if (!pdfBase64) {
                e.currentTarget.style.borderColor = S.primary;
                e.currentTarget.style.background = S.bgTint;
              }
            }}
            onMouseOut={e => {
              if (!pdfBase64) {
                e.currentTarget.style.borderColor = S.line;
                e.currentTarget.style.background = S.bgSoft;
              }
            }}
          >
            <input ref={fileRef} type="file" accept=".pdf,.docx,.txt"
              onChange={handleFile} style={{ display: 'none' }} />
            <div style={{ fontSize: 44, marginBottom: 14 }}>
              {pdfBase64 ? '📄' : '📤'}
            </div>
            <div style={{
              fontFamily: fontDisplay,
              fontSize: 19, fontWeight: 700, color: S.ink, marginBottom: 6,
            }}>{fileName || 'Choose a file'}</div>
            <div style={{ fontSize: 14, color: S.muted, marginBottom: 12 }}>
              {pdfBase64
                ? `PDF · ${formatSize(fileSize)} · ready to extract`
                : 'or drag and drop here'}
            </div>
            <div style={{
              display: 'inline-block', padding: '4px 12px',
              background: S.bg, borderRadius: 100,
              fontSize: 11, fontWeight: 700, color: S.muted, letterSpacing: '0.05em',
            }}>.PDF · .DOCX · .TXT</div>
          </div>
          {text && fileName && !pdfBase64 && (
            <div style={{
              marginTop: 12, padding: 14,
              background: S.accentBg, borderRadius: 10,
              fontSize: 13, color: '#065F46',
              display: 'flex', alignItems: 'center', gap: 10,
            }}>
              <span>✓</span>
              <span>Loaded <strong>{fileName}</strong> · {text.length.toLocaleString()} chars</span>
            </div>
          )}
          {pdfBase64 && (
            <div style={{
              marginTop: 12, padding: 14,
              background: S.bgTint, borderRadius: 10,
              fontSize: 12, color: S.textSoft, lineHeight: 1.5,
            }}>
              <strong>How PDFs work here:</strong> the file is sent directly to Claude as a document
              — Claude reads the layout, including scanned pages, and extracts structured data.
              No browser-side PDF parser needed.
            </div>
          )}
        </div>
      )}

      <button onClick={handleExtract}
        disabled={!canExtract}
        style={{
          marginTop: 22, padding: '13px 28px',
          background: canExtract ? S.primary : S.line,
          color: '#fff', border: 'none', borderRadius: 100,
          fontSize: 15, fontWeight: 700, fontFamily: fontBody,
          cursor: canExtract ? 'pointer' : 'not-allowed',
          boxShadow: canExtract ? '0 6px 16px rgba(8,35,28,0.18)' : 'none',
        }}>✨ Extract with Claude →</button>
    </div>
  );
}

