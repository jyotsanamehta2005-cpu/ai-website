- Keep all factual content. If an improvement asks for a metric you don't have, rephrase to be specific without inventing numbers.

IMPROVEMENTS TO INCORPORATE:
${improvementsList}

ORIGINAL RÉSUMÉ:
${currentText}`;

  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-20250514",
      max_tokens: 2500,
      messages: [{ role: "user", content: prompt }]
    })
  });
  if (!response.ok) throw new Error('AI request failed');
  const data = await response.json();
  const textBlock = data.content.find(c => c.type === 'text');
  if (!textBlock) throw new Error('No response');
  let cleaned = textBlock.text.trim()
    .replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/```$/, '').trim();
  const first = cleaned.indexOf('{');
  const last = cleaned.lastIndexOf('}');
  if (first >= 0 && last > first) cleaned = cleaned.slice(first, last + 1);
  return JSON.parse(cleaned);
}

