                <span style={{
                  padding: '1px 8px',
                  background: active ? S.bgTint : '#fff',
                  color: active ? S.primary : S.muted,
                  borderRadius: 100,
                  fontSize: 10, fontWeight: 800,
                  minWidth: 22, textAlign: 'center',
                }}>{t.c}</span>
              )}
            </button>
          );
        })}
      </div>

      {/* The views */}
      {applications.length === 0 ? (
        <EmptyApplications onBrowseJobs={onBrowseJobs} />
      ) : view === 'tracker' ? (
        <TrackerView
          apps={activeApps}
          filter={filter} setFilter={setFilter}
          onOpen={setSelectedId}
          onStatusChange={(id, status) => updateApp(id, { status })}
        />
      ) : view === 'calendar' ? (
        <CalendarView apps={applications} onOpen={setSelectedId} />
      ) : (
        <SavedView
          jobs={savedJobs} onOpen={setSelectedId}
          onMarkApplied={(id) => updateApp(id, { status: 'applied' })}
          onBrowseJobs={onBrowseJobs}
        />
      )}
    </div>
  );
}

