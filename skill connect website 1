function FontLoader({ bodyFamily, displayFamily }) {
  useEffect(() => {
    const linkId = 'sc-google-fonts';
    const enc = (f) => f.replace(/\s+/g, '+');
    const body = FONT_OPTIONS.body.find(f => f.family === bodyFamily) || FONT_OPTIONS.body[0];
    const disp = FONT_OPTIONS.display.find(f => f.family === displayFamily) || FONT_OPTIONS.display[0];
    const url = `https://fonts.googleapis.com/css2?family=${enc(body.family)}:wght@${body.weights}&family=${enc(disp.family)}:wght@${disp.weights}&display=swap`;
    let link = document.getElementById(linkId);
    if (!link) {
      link = document.createElement('link');
      link.id = linkId;
      link.rel = 'stylesheet';
      document.head.appendChild(link);
    }
    if (link.href !== url) link.href = url;
  }, [bodyFamily, displayFamily]);
  return null;
}

