        <div style={{ display: 'flex', alignItems: 'center', gap: 14 }}>
          <div style={{
            padding: '9px 16px',
            background: lowTime ? '#FEE2E2' : (remaining <= 300 ? '#FEF3C7' : S.bgTint),
            color: timerColor,
            borderRadius: 100, fontSize: 14, fontWeight: 800,
