// ---------- Report screen ----------
function AptitudeReport({ report, preset, onRestart, onTryAgain }) {
  const [showAll, setShowAll] = useState(false);
  const [filter, setFilter] = useState('all'); // all | incorrect | unattempted

  const score = report.score;
  const color = score >= 75 ? '#10B981' : score >= 50 ? '#F59E0B' : '#EF4444';
  const verdict = score >= 75 ? 'Strong — you would clear this round.'
    : score >= 50 ? 'On the bubble — practice the weak topics and retry.'
    : 'Needs more practice. Focus on the gaps below.';

  const visibleDetails = report.details.filter(d => {
    if (filter === 'incorrect')   return d.isAttempted && !d.isCorrect;
    if (filter === 'unattempted') return !d.isAttempted;
    return true;
  });

  const fmtMin = (s) => {
    const m = Math.floor(s / 60);
    const ss = s % 60;
    return m > 0 ? `${m}m ${ss}s` : `${ss}s`;
  };

  return (
    <div className="fade">
      {/* Score panel */}
      <div className="fadeUp" style={{
        padding: 32, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 20, marginBottom: 16,
        display: 'grid', gridTemplateColumns: 'auto 1fr', gap: 36,
        alignItems: 'center',
      }}>
        <ScoreRing score={score} size={180} color={color} />
        <div>
          <div style={{
            display: 'inline-block', padding: '4px 12px',
            background: color === '#10B981' ? S.accentBg : color === '#F59E0B' ? '#FEF3C7' : '#FEE2E2',
            color, borderRadius: 100, fontSize: 11, fontWeight: 800,
            letterSpacing: '0.1em', marginBottom: 10,
          }}>{preset.name.toUpperCase()}</div>
          <h1 style={{
            fontFamily: fontDisplay,
            fontSize: 24, fontWeight: 700, color: S.ink,
            margin: '0 0 18px', letterSpacing: '-0.015em', lineHeight: 1.25,
          }}>{verdict}</h1>

          <div style={{
            display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 12,
          }}>
            <ReportStat label="Correct"  value={report.correct} total={report.totalQuestions} color="#10B981" />
            <ReportStat label="Wrong"    value={report.incorrect} total={report.totalQuestions} color="#EF4444" />
            <ReportStat label="Skipped"  value={report.unattempted} total={report.totalQuestions} color={S.muted} />
            <ReportStat label="Accuracy" value={`${report.accuracy}%`} color={S.primary} />
          </div>
        </div>
      </div>

      {/* Section breakdown */}
      <div className="fadeUp" style={{
        padding: 24, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 16, marginBottom: 14, animationDelay: '0.05s',
      }}>
        <h3 style={{
          fontFamily: fontDisplay,
          fontSize: 17, fontWeight: 700, color: S.ink,
          margin: '0 0 14px',
        }}>Section breakdown</h3>
        <div style={{ display: 'grid', gap: 12 }}>
          {report.bySection.map((s, i) => (
            <CategoryBar key={i}
              label={s.name}
              value={s.score}
              hint={`${s.correct}/${s.total} correct · ${s.attempted}/${s.total} attempted`}
            />
          ))}
        </div>
      </div>

      {/* Weak topics & time */}
      <div className="fadeUp" style={{
        display: 'grid', gridTemplateColumns: '2fr 1fr', gap: 14,
        marginBottom: 14, animationDelay: '0.08s',
      }}>
        {report.weakTopics.length > 0 && (
          <div style={{
            padding: 24, background: S.bg, border: `1px solid ${S.line}`,
            borderRadius: 16,
          }}>
            <h3 style={{
              fontFamily: fontDisplay,
              fontSize: 16, fontWeight: 700, color: S.ink,
              margin: '0 0 12px',
            }}>📚 Topics to revise</h3>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8 }}>
              {report.weakTopics.map((t, i) => (
                <span key={i} style={{
                  padding: '7px 14px',
                  background: '#FEE2E2', color: '#991B1B',
                  borderRadius: 100, fontSize: 13, fontWeight: 600,
                  display: 'inline-flex', alignItems: 'center', gap: 6,
                }}>
                  {t.topic}
                  <span style={{
                    padding: '1px 7px', background: '#FECACA', color: '#991B1B',
                    borderRadius: 100, fontSize: 10, fontWeight: 800,
                  }}>{t.missCount}</span>
                </span>
              ))}
            </div>
          </div>
        )}

        <div style={{
          padding: 24, background: S.bg, border: `1px solid ${S.line}`,
          borderRadius: 16,
        }}>
          <h3 style={{
            fontFamily: fontDisplay,
            fontSize: 16, fontWeight: 700, color: S.ink,
            margin: '0 0 12px',
          }}>⏱ Time</h3>
          <div style={{
            fontFamily: fontDisplay, fontSize: 26, fontWeight: 700,
            color: S.ink, letterSpacing: '-0.015em', marginBottom: 4,
          }}>{fmtMin(report.totalTimeSec)}</div>
          <div style={{ fontSize: 12, color: S.muted }}>Total · {fmtMin(report.avgTimePerQuestion)} avg/Q</div>
        </div>
      </div>

      {/* All-questions review */}
      <div className="fadeUp" style={{
        padding: 24, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 16, marginBottom: 22, animationDelay: '0.1s',
      }}>
        <div style={{
          display: 'flex', justifyContent: 'space-between', alignItems: 'center',
          marginBottom: 14, flexWrap: 'wrap', gap: 10,
        }}>
          <h3 style={{
            fontFamily: fontDisplay,
            fontSize: 17, fontWeight: 700, color: S.ink, margin: 0,
          }}>Review answers</h3>
          <div style={{ display: 'flex', gap: 6 }}>
            {[
              { k: 'all', l: `All (${report.totalQuestions})` },
              { k: 'incorrect', l: `Wrong (${report.incorrect})` },
              { k: 'unattempted', l: `Skipped (${report.unattempted})` },
            ].map(f => (
              <button key={f.k} onClick={() => setFilter(f.k)} style={{
                padding: '6px 12px',
                background: filter === f.k ? S.primary : S.bg,
                color: filter === f.k ? '#fff' : S.text,
                border: `1.5px solid ${filter === f.k ? S.primary : S.line}`,
                borderRadius: 100, fontSize: 11, fontWeight: 700,
                cursor: 'pointer', fontFamily: fontBody,
              }}>{f.l}</button>
            ))}
          </div>
        </div>

        {visibleDetails.length === 0 && (
          <div style={{ padding: 24, textAlign: 'center', color: S.muted, fontSize: 13 }}>
            Nothing in this filter — good work!
          </div>
        )}

        {visibleDetails.map((d, idx) => {
          const status = !d.isAttempted ? 'skipped' : d.isCorrect ? 'correct' : 'wrong';
          const statusColors = {
            correct: { bg: S.accentBg, fg: '#065F46', icon: '✓' },
            wrong:   { bg: '#FEE2E2', fg: '#991B1B', icon: '✕' },
            skipped: { bg: S.bgSoft, fg: S.muted, icon: '—' },
          };
          const sc = statusColors[status];

          return (
            <div key={d.id} style={{
              padding: 18, marginBottom: 10,
              background: S.bgSoft, borderRadius: 12,
              border: `1px solid ${S.line}`,
            }}>
              <div style={{ display: 'flex', alignItems: 'flex-start', gap: 12, marginBottom: 12 }}>
                <div style={{
                  width: 36, height: 36, borderRadius: '50%',
                  background: sc.bg, color: sc.fg,
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                  fontSize: 16, fontWeight: 800, flexShrink: 0,
                }}>{sc.icon}</div>
                <div style={{ flex: 1, minWidth: 0 }}>
                  <div style={{
                    fontSize: 11, fontWeight: 700, color: S.muted,
                    letterSpacing: '0.06em', marginBottom: 4,
                  }}>
                    Q{d.id} · {d.section}{d.topic && ` · ${d.topic}`} · {fmtMin(d.timeSec)}
                  </div>
                  <div style={{
                    fontSize: 14, fontWeight: 600, color: S.ink, lineHeight: 1.5,
                  }}>{d.question}</div>
                </div>
              </div>

              <div style={{ display: 'flex', flexDirection: 'column', gap: 6, marginBottom: 12 }}>
                {d.options.map((opt, i) => {
                  const isCorrect = i === d.correctIndex;
                  const isSelected = i === d.selected;
                  let bg = '#fff', border = S.line, color = S.text;
                  if (isCorrect) { bg = S.accentBg; border = '#A7F3D0'; color = '#065F46'; }
                  else if (isSelected && !isCorrect) { bg = '#FEE2E2'; border = '#FECACA'; color = '#991B1B'; }
                  return (
                    <div key={i} style={{
                      padding: '10px 14px',
                      background: bg, color, border: `1.5px solid ${border}`,
                      borderRadius: 9, fontSize: 13.5, lineHeight: 1.5,
                      display: 'flex', alignItems: 'center', gap: 10,
                    }}>
                      <span style={{
                        width: 22, height: 22, borderRadius: '50%',
                        background: isCorrect ? '#10B981' : (isSelected ? '#EF4444' : '#fff'),
                        color: isCorrect || isSelected ? '#fff' : S.muted,
                        border: `1.5px solid ${isCorrect ? '#10B981' : (isSelected ? '#EF4444' : S.line)}`,
                        display: 'flex', alignItems: 'center', justifyContent: 'center',
                        fontWeight: 700, fontSize: 11, flexShrink: 0,
                      }}>{String.fromCharCode(65 + i)}</span>
                      <span style={{ flex: 1 }}>{opt}</span>
                      {isCorrect && <span style={{ fontSize: 11, fontWeight: 700 }}>CORRECT</span>}
                      {isSelected && !isCorrect && <span style={{ fontSize: 11, fontWeight: 700 }}>YOUR PICK</span>}
                    </div>
                  );
                })}
              </div>

              <div style={{
                padding: 12, background: S.bgTint, borderRadius: 9,
                fontSize: 13, color: S.text, lineHeight: 1.55,
              }}>
                <strong style={{ color: S.primary }}>Why:</strong> {d.explanation}
              </div>
            </div>
          );
        })}
      </div>

      <div className="fadeUp" style={{
        display: 'flex', gap: 10, flexWrap: 'wrap', animationDelay: '0.12s',
      }}>
        <button onClick={onTryAgain} style={{
          padding: '12px 24px', background: S.primary, color: '#fff',
          border: 'none', borderRadius: 100,
          fontSize: 14, fontWeight: 700, fontFamily: fontBody,
          cursor: 'pointer', boxShadow: '0 6px 16px rgba(13,148,136,0.25)',
          display: 'flex', alignItems: 'center', gap: 8,
        }}>🧮 Take a new {preset.name} test</button>
        <button onClick={onRestart} style={{
          padding: '12px 24px', background: S.bg, color: S.text,
          border: `1.5px solid ${S.line}`, borderRadius: 100,
          fontSize: 14, fontWeight: 600, fontFamily: fontBody,
          cursor: 'pointer',
        }}>Try a different company</button>
      </div>
    </div>
  );
}

