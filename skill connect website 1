// ---------- Live interview screen ----------
function InterviewSession({ questions, currentQ, currentAnswer, setCurrentAnswer,
                            onNext, onSkip, startTime }) {
  const q = questions[currentQ];
  const isLast = currentQ === questions.length - 1;
  const wordCount = currentAnswer.trim() ? currentAnswer.trim().split(/\s+/).length : 0;

  const [elapsed, setElapsed] = useState(0);
  const [listening, setListening] = useState(false);
  const [voiceSupported, setVoiceSupported] = useState(false);
  const [voiceError, setVoiceError] = useState('');
  const recogRef = useRef(null);
  const baseTextRef = useRef('');  // text that existed before the current voice session

  useEffect(() => {
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    setVoiceSupported(!!SR);
  }, []);

  // Stop listening when question changes
  useEffect(() => {
    if (recogRef.current) {
      try { recogRef.current.stop(); } catch (e) {}
      setListening(false);
    }
  }, [currentQ]);

  useEffect(() => {
    if (!startTime) return;
    const interval = setInterval(() => {
      setElapsed(Math.floor((Date.now() - startTime) / 1000));
    }, 1000);
    return () => clearInterval(interval);
  }, [startTime]);

  const startListening = () => {
    setVoiceError('');
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) {
      setVoiceError('Voice input is not supported in this browser. Use Chrome, Edge, or Safari.');
      return;
    }
    const recog = new SR();
    recog.lang = 'en-IN';
    recog.continuous = true;
    recog.interimResults = true;

    baseTextRef.current = currentAnswer.trim()
      ? currentAnswer.trim() + ' '
      : '';

    recog.onresult = (event) => {
      let interim = '';
      let final = '';
      for (let i = event.resultIndex; i < event.results.length; i++) {
        const transcript = event.results[i][0].transcript;
        if (event.results[i].isFinal) {
          final += transcript + ' ';
        } else {
          interim += transcript;
        }
      }
      if (final) {
        baseTextRef.current += final;
      }
      setCurrentAnswer((baseTextRef.current + interim).trimEnd());
    };

    recog.onerror = (e) => {
      if (e.error === 'not-allowed') {
        setVoiceError('Microphone access denied. Please allow microphone access and try again.');
      } else if (e.error === 'no-speech') {
        setVoiceError('No speech detected. Try speaking a bit louder.');
      } else if (e.error !== 'aborted') {
        setVoiceError(`Voice error: ${e.error}. Try typing instead.`);
      }
      setListening(false);
    };

    recog.onend = () => {
      setListening(false);
    };

    try {
      recog.start();
      recogRef.current = recog;
      setListening(true);
    } catch (e) {
      setVoiceError('Could not start voice recognition.');
    }
  };

  const stopListening = () => {
    if (recogRef.current) {
      try { recogRef.current.stop(); } catch (e) {}
    }
    setListening(false);
  };

  const toggleVoice = () => {
    if (listening) stopListening();
    else startListening();
  };

  const fmt = (s) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

  const typeColors = {
    behavioral: { bg: '#DBEAFE', fg: '#1E40AF' },
    technical:  { bg: '#EDE9FE', fg: '#5B21B6' },
    hr:         { bg: '#FEF3C7', fg: '#92400E' },
  };
  const typeStyle = typeColors[q.type] || { bg: S.bgTint, fg: S.primary };

  return (
    <div className="fade">
      {/* Progress */}
      <div className="fadeUp" style={{ marginBottom: 22 }}>
        <div style={{
          display: 'flex', justifyContent: 'space-between', alignItems: 'center',
          marginBottom: 10,
        }}>
          <div style={{
            fontSize: 13, fontWeight: 700, color: S.text,
          }}>Question <span style={{ color: S.primary }}>{currentQ + 1}</span> of {questions.length}</div>
          <div style={{
            fontSize: 12, color: S.muted, fontVariantNumeric: 'tabular-nums',
            display: 'flex', alignItems: 'center', gap: 6,
          }}>
            <span style={{
              width: 8, height: 8, borderRadius: '50%', background: '#EF4444',
              animation: 'pulse 1.6s ease infinite',
            }} />
            <style>{`@keyframes pulse { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }`}</style>
            {fmt(elapsed)} elapsed
          </div>
        </div>
        <div style={{ height: 6, background: S.line, borderRadius: 3, overflow: 'hidden' }}>
          <div style={{
            height: '100%',
            width: `${((currentQ + 1) / questions.length) * 100}%`,
            background: `linear-gradient(90deg, ${S.primary}, ${S.accent})`,
            borderRadius: 3, transition: 'width 0.4s cubic-bezier(0.16,1,0.3,1)',
          }} />
        </div>
      </div>

      {/* Question card */}
      <div className="fadeUp" key={currentQ} style={{
        padding: 32, background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 18, marginBottom: 18, animationDelay: '0.05s',
      }}>
        <div style={{
          display: 'inline-block', padding: '3px 10px',
          background: typeStyle.bg, color: typeStyle.fg,
          borderRadius: 100, fontSize: 10, fontWeight: 800,
          letterSpacing: '0.1em', textTransform: 'uppercase', marginBottom: 14,
        }}>{q.type}</div>
        <h2 style={{
          fontFamily: fontDisplay,
          fontSize: 22, fontWeight: 700, color: S.ink,
          margin: '0 0 14px', letterSpacing: '-0.015em', lineHeight: 1.3,
        }}>{q.question}</h2>
        {q.hint && (
          <div style={{
            padding: 12, background: S.bgTint, borderRadius: 10,
            fontSize: 13, color: S.textSoft, lineHeight: 1.5,
            display: 'flex', alignItems: 'flex-start', gap: 8,
          }}>
            <span style={{ flexShrink: 0 }}>💡</span>
            <span><strong style={{ color: S.primary }}>Hint:</strong> {q.hint}</span>
          </div>
        )}
      </div>

      {/* Answer area */}
      <div className="fadeUp" style={{ animationDelay: '0.08s' }}>
        <div style={{ position: 'relative' }}>
          <textarea
            value={currentAnswer}
            onChange={e => setCurrentAnswer(e.target.value)}
            placeholder={voiceSupported
              ? "Type your answer or tap the mic to speak. Aim for 100-300 words. Use STAR format for behavioral questions."
              : "Type your answer here. Take your time — aim for 100-300 words. Use the STAR format for behavioral questions (Situation, Task, Action, Result)."}
            autoFocus
            style={{
              width: '100%', minHeight: 220,
              padding: voiceSupported ? '18px 18px 18px 18px' : 18,
              paddingBottom: voiceSupported ? 56 : 18,
              border: `1.5px solid ${listening ? '#EF4444' : S.line}`,
              borderRadius: 14,
              background: S.bg, fontSize: 14.5, lineHeight: 1.6,
              color: S.ink, resize: 'vertical', fontFamily: fontBody,
              transition: 'border 0.15s',
            }}
          />
          {voiceSupported && (
            <button
              onClick={toggleVoice}
              type="button"
              style={{
                position: 'absolute', bottom: 12, left: 12,
                padding: '8px 14px',
                background: listening ? '#EF4444' : S.primary,
                color: '#fff', border: 'none', borderRadius: 100,
                fontSize: 12, fontWeight: 700, fontFamily: fontBody,
                cursor: 'pointer',
                display: 'flex', alignItems: 'center', gap: 7,
                boxShadow: listening
                  ? '0 4px 14px rgba(239,68,68,0.4)'
                  : '0 4px 12px rgba(13,148,136,0.3)',
                transition: 'all 0.15s',
              }}>
              {listening ? (
                <>
                  <span style={{
                    width: 8, height: 8, borderRadius: '50%', background: '#fff',
                    animation: 'pulse 1.2s ease infinite',
                  }} />
                  <style>{`@keyframes pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }`}</style>
                  Listening — tap to stop
                </>
              ) : (
                <>🎙️ Speak your answer</>
              )}
            </button>
          )}
        </div>

        {voiceError && (
          <div style={{
            marginTop: 10, padding: 10,
            background: '#FEE2E2', borderRadius: 8,
            fontSize: 12, color: '#B91C1C', fontWeight: 600,
          }}>{voiceError}</div>
        )}

        <div style={{
          display: 'flex', justifyContent: 'space-between', alignItems: 'center',
          marginTop: 12, marginBottom: 18, fontSize: 12, color: S.muted,
        }}>
          <span style={{ fontWeight: 600 }}>{wordCount} words</span>
          <span>{wordCount < 30 ? 'Try to give a fuller answer' : wordCount < 100 ? 'Good — keep going' : wordCount < 350 ? '✓ Solid length' : 'Tighten if you can'}</span>
        </div>

        <div style={{ display: 'flex', gap: 10, justifyContent: 'flex-end', flexWrap: 'wrap' }}>
          <button onClick={onSkip} style={{
            padding: '11px 22px', background: S.bg, color: S.muted,
            border: `1.5px solid ${S.line}`, borderRadius: 100,
            fontSize: 13, fontWeight: 600, fontFamily: fontBody,
            cursor: 'pointer',
          }}>Skip this question</button>
          <button onClick={onNext}
            disabled={currentAnswer.trim().length < 5}
            style={{
              padding: '11px 26px',
              background: currentAnswer.trim().length < 5 ? S.line : S.primary,
              color: '#fff', border: 'none', borderRadius: 100,
              fontSize: 14, fontWeight: 700, fontFamily: fontBody,
              cursor: currentAnswer.trim().length < 5 ? 'not-allowed' : 'pointer',
              boxShadow: currentAnswer.trim().length < 5 ? 'none' : '0 6px 16px rgba(8,35,28,0.18)',
              display: 'flex', alignItems: 'center', gap: 8,
            }}>
            {isLast ? 'Finish interview ✓' : 'Next question →'}
          </button>
        </div>
      </div>
    </div>
  );
}

