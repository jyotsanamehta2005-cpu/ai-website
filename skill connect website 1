              <button onClick={handleClearWrap} style={ctrlBtnGhost}>Clear</button>
              <button onClick={onMark}
                style={marked[currentQ] ? ctrlBtnMarkedActive : ctrlBtnMarked}>
                {marked[currentQ] ? '🚩 Unmark' : '🚩 Mark for review'}
              </button>
            </div>
            <div style={{ display: 'flex', gap: 8 }}>
              <button onClick={() => onNavigate(Math.max(0, currentQ - 1))}
                disabled={currentQ === 0} style={{
                  ...ctrlBtnGhost,
                  opacity: currentQ === 0 ? 0.4 : 1,
                  cursor: currentQ === 0 ? 'not-allowed' : 'pointer',
                }}>← Previous</button>
              <button onClick={() => onNavigate(Math.min(questions.length - 1, currentQ + 1))}
                disabled={currentQ === questions.length - 1}
                style={{
                  ...ctrlBtnSolid,
                  opacity: currentQ === questions.length - 1 ? 0.5 : 1,
                  cursor: currentQ === questions.length - 1 ? 'not-allowed' : 'pointer',
                }}>Next →</button>
            </div>
          </div>
        </div>

        {/* Question palette sidebar */}
        <div className="fadeUp" style={{ animationDelay: '0.1s' }}>
          <div style={{
            padding: 18, background: S.bg, border: `1px solid ${S.line}`,
            borderRadius: 14, position: 'sticky', top: 16,
          }}>
            <div style={{
              fontSize: 11, fontWeight: 700, color: S.muted,
              letterSpacing: '0.08em', marginBottom: 12,
            }}>QUESTION PALETTE</div>

            <div style={{
              display: 'grid', gridTemplateColumns: 'repeat(5, 1fr)', gap: 6,
              marginBottom: 16,
            }}>
              {questions.map((_, i) => {
                const isAnswered = answers[i] !== null && answers[i] !== undefined;
                const isMarked = marked[i];
                const isCurrent = i === currentQ;
                let bg, fg, border;
                if (isCurrent) { bg = S.primary; fg = '#fff'; border = S.primary; }
                else if (isMarked && isAnswered) { bg = '#7C3AED'; fg = '#fff'; border = '#7C3AED'; }
                else if (isMarked) { bg = '#FEF3C7'; fg = '#92400E'; border = '#FCD34D'; }
                else if (isAnswered) { bg = S.accentBg; fg = '#065F46'; border = '#A7F3D0'; }
                else { bg = '#fff'; fg = S.muted; border = S.line; }
                return (
                  <button key={i} onClick={() => onNavigate(i)}
                    style={{
                      width: '100%', aspectRatio: '1',
                      background: bg, color: fg,
                      border: `1.5px solid ${border}`,
                      borderRadius: 8, fontSize: 12, fontWeight: 700,
                      cursor: 'pointer', fontFamily: fontBody,
                    }}>{i + 1}</button>
                );
              })}
            </div>

            <div style={{ borderTop: `1px solid ${S.lineSoft}`, paddingTop: 12 }}>
              <PaletteLegend color={S.primary} text="#fff" label="Current" />
              <PaletteLegend color={S.accentBg} text="#065F46" border="#A7F3D0" label={`Answered (${answered})`} />
              <PaletteLegend color="#FEF3C7" text="#92400E" border="#FCD34D" label={`Marked (${markedCount})`} />
              <PaletteLegend color="#7C3AED" text="#fff" label="Answered + Marked" />
              <PaletteLegend color="#fff" text={S.muted} border={S.line} label={`Not visited (${questions.length - answered})`} />
            </div>
          </div>
        </div>
      </div>

      {/* Submit confirm modal */}
      {showSubmitConfirm && (
        <div onClick={() => setShowSubmitConfirm(false)} style={{
          position: 'fixed', inset: 0, zIndex: 400,
          background: 'rgba(13,33,55,0.65)',
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          padding: 24, animation: 'fadeIn 0.2s ease both',
        }}>
          <div onClick={e => e.stopPropagation()} style={{
            maxWidth: 460, width: '100%', background: '#fff',
            borderRadius: 18, padding: 32,
            boxShadow: '0 40px 80px rgba(0,0,0,0.3)',
          }}>
            <h2 style={{
              fontFamily: fontDisplay, fontSize: 22, fontWeight: 700, color: S.ink,
              margin: '0 0 10px', letterSpacing: '-0.015em',
            }}>Submit test?</h2>
            <p style={{ fontSize: 14, color: S.muted, margin: '0 0 18px', lineHeight: 1.55 }}>
              You've answered <strong style={{ color: S.ink }}>{answered}</strong> of {questions.length} questions.
              {answered < questions.length && ' Unanswered questions will be marked as incorrect.'}
            </p>
            <div style={{ display: 'flex', gap: 10, justifyContent: 'flex-end' }}>
              <button onClick={() => setShowSubmitConfirm(false)} style={{
                padding: '10px 18px', background: S.bg, color: S.text,
                border: `1.5px solid ${S.line}`, borderRadius: 10,
                fontSize: 13, fontWeight: 600, cursor: 'pointer', fontFamily: fontBody,
              }}>Keep going</button>
              <button onClick={() => { setShowSubmitConfirm(false); onSubmit(); }} style={{
                padding: '10px 18px', background: S.primary, color: '#fff',
                border: 'none', borderRadius: 10, fontSize: 13, fontWeight: 700,
                cursor: 'pointer', fontFamily: fontBody,
                boxShadow: '0 4px 12px rgba(13,148,136,0.3)',
              }}>Yes, submit</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );

  function handleClearWrap() { onClear(); }
}

