function JobDetail({ job, match, user, settings, isSaved, savedStatus, onSave, onUnsave, onApplied, onBack, onUpload }) {
  const [tailoring, setTailoring]     = useState(false);
  const [tailorStage, setTailorStage] = useState('');
  const [tailored, setTailored]       = useState(null);
  const [tailorError, setTailorError] = useState('');
  const [applyOpened, setApplyOpened] = useState(false);

  const company = settings.companies.find(c => c.id === job.companyId);
  const hasResume = !!user.profile;

  const resumeText = useMemo(() => {
    if (user.rawResume && !user.rawResume.startsWith('[PDF:')) return user.rawResume;
    return profileToText(user.profile);
  }, [user]);

  const handleTailor = async () => {
    if (!hasResume) return setTailorError('Upload your résumé first.');
    setTailorError(''); setTailored(null); setTailoring(true);
    try {
      setTailorStage('Reading the job description');
      await new Promise(r => setTimeout(r, 350));
      setTailorStage('Tailoring your résumé');
      const newProfile = await tailorResume(resumeText, job);
      setTailorStage('Polishing');
      await new Promise(r => setTimeout(r, 250));
      setTailored(newProfile);
