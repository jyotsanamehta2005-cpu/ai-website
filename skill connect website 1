function UserTypesSection({ draft, update }) {
  const addType = () => {
    const id = `type${Date.now()}`;
    update('userTypes', [...draft.userTypes, { id, label: 'New Type', icon: '🆕', enabled: true }]);
  };
  const removeType = (idx) => {
    if (draft.userTypes.length <= 1) return alert('At least one user type is required.');
    update('userTypes', draft.userTypes.filter((_, i) => i !== idx));
  };
  const updateType = (idx, patch) => {
    const next = draft.userTypes.map((t, i) => i === idx ? { ...t, ...patch } : t);
    update('userTypes', next);
  };

  return (
    <>
      <SectionHeader
        title="User Types"
        description="The pill tabs at the top of the login form. Add, rename, or hide any of them."
      />
      <Card title="Types" action={
        <button onClick={addType} style={solidBtn}>+ Add type</button>
      }>
        {draft.userTypes.map((t, i) => (
          <div key={t.id} style={{
            display: 'grid', gridTemplateColumns: '50px 1fr 1fr auto auto', gap: 12,
            alignItems: 'center', padding: 14, marginBottom: 10,
            background: A.bg, borderRadius: 11, border: `1px solid ${A.line}`,
          }}>
            <input value={t.icon} onChange={e => updateType(i, { icon: e.target.value })}
              maxLength={4}
              className="admin-input"
              style={{ ...adminInputStyle, textAlign: 'center', fontSize: 22, padding: '8px 4px' }} />
            <input value={t.label} onChange={e => updateType(i, { label: e.target.value })}
              className="admin-input" placeholder="Label" style={adminInputStyle} />
            <input value={t.id} onChange={e => updateType(i, { id: e.target.value.replace(/\s/g, '').toLowerCase() })}
              className="admin-input" placeholder="id"
              style={{ ...adminInputStyle, fontFamily: 'monospace', fontSize: 12 }} />
            <button onClick={() => updateType(i, { enabled: !t.enabled })}
              style={{
                padding: '7px 12px',
                background: t.enabled ? A.accent + '22' : A.bg,
                color: t.enabled ? '#065F46' : A.muted,
                border: `1px solid ${t.enabled ? A.accent + '44' : A.line}`,
                borderRadius: 8, fontSize: 11, fontWeight: 700,
                cursor: 'pointer', fontFamily: fontBody,
              }}>{t.enabled ? 'ON' : 'OFF'}</button>
            <button onClick={() => removeType(i)} className="danger-btn"
              style={{
                width: 32, height: 32, background: '#fff', color: A.danger,
                border: `1px solid ${A.line}`, borderRadius: 8,
                fontSize: 14, cursor: 'pointer',
              }}>×</button>
          </div>
        ))}
      </Card>
    </>
  );
}

