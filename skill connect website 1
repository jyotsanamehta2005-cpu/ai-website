async function fetchPageText(url) {
  // Use r.jina.ai — a free reader that returns clean markdown text from any URL.
  const cleanUrl = url.replace(/^https?:\/\//, '');
  const readerUrl = `https://r.jina.ai/https://${cleanUrl}`;
  const res = await fetch(readerUrl, {
    headers: { 'Accept': 'text/plain', 'X-Return-Format': 'markdown' },
  });
  if (!res.ok) {
    throw new Error(`Could not read page (status ${res.status}). The site may block scraping.`);
  }
  const text = await res.text();
  if (!text || text.length < 100) {
    throw new Error('Page returned no readable content.');
  }
  return text;
}

