              }}>No jobs match your filters. Try clearing them.</div>
            )}
            {filtered.map(job => (
              <JobCard key={job.id} job={job}
                match={matchMap ? matchMap[job.id] : null}
                isSaved={!!findApp(job.id)}
                onSave={() => saveJob(job)}
                onUnsave={() => unsaveJob(job)}
                onClick={() => setSelectedJobId(job.id)} />
            ))}
          </div>
        </>
      )}
    </div>
  );
}

