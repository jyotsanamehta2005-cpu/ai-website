// ---------- Live test session ----------
function AptitudeSession({ preset, questions, answers, marked, currentQ,
                          startTime, onSelect, onMark, onClear, onNavigate, onSubmit }) {
  const q = questions[currentQ];
  const totalSec = preset.durationMinutes * 60;
  const [remaining, setRemaining] = useState(totalSec);
  const [showSubmitConfirm, setShowSubmitConfirm] = useState(false);

  useEffect(() => {
    if (!startTime) return;
    const tick = () => {
      const elapsed = Math.floor((Date.now() - startTime) / 1000);
      const left = Math.max(0, totalSec - elapsed);
      setRemaining(left);
      if (left === 0) onSubmit();
    };
    tick();
    const interval = setInterval(tick, 1000);
    return () => clearInterval(interval);
  }, [startTime, totalSec, onSubmit]);

  const fmt = (s) => {
    const m = Math.floor(s / 60);
    const ss = s % 60;
    return `${String(m).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
  };

  const lowTime = remaining <= 60;
  const timerColor = lowTime ? '#DC2626' : remaining <= 300 ? '#F59E0B' : S.primary;

  const answered = answers.filter(a => a !== null && a !== undefined).length;
  const markedCount = marked.filter(Boolean).length;

  // Section colors
  const sectionColors = {
    'Quantitative Aptitude':  { bg: '#DBEAFE', fg: '#1E40AF' },
    'Logical Reasoning':      { bg: '#EDE9FE', fg: '#5B21B6' },
    'Verbal Ability':         { bg: '#FEF3C7', fg: '#92400E' },
    'Coding MCQ':             { bg: S.bgTint, fg: S.primary },
    'Pseudocode':             { bg: S.bgTint, fg: S.primary },
    'Computer Fundamentals':  { bg: S.bgTint, fg: S.primary },
    'Written Communication':  { bg: '#FEF3C7', fg: '#92400E' },
  };
  const sectStyle = sectionColors[q.section] || { bg: S.bgTint, fg: S.primary };

  return (
    <div className="fade">
      {/* Top bar */}
      <div className="fadeUp" style={{
        display: 'flex', alignItems: 'center', justifyContent: 'space-between',
        padding: '14px 20px', background: S.bg, border: `1px solid ${S.line}`,
        borderRadius: 14, marginBottom: 16, flexWrap: 'wrap', gap: 12,
      }}>
        <div>
          <div style={{
            fontFamily: fontDisplay, fontSize: 18, fontWeight: 700,
            color: S.ink, letterSpacing: '-0.01em',
          }}>{preset.name}</div>
          <div style={{ fontSize: 12, color: S.muted, marginTop: 2 }}>
            Question {currentQ + 1} of {questions.length} · {answered} answered · {markedCount} marked
