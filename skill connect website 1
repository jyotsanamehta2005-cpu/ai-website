          {step === 'select' && (
            <>
              <div style={{ textAlign: 'center', marginBottom: 26 }}>
                <h1 style={{
                  fontFamily: fontDisplay,
                  fontSize: 26, fontWeight: 800, color: '#1A2B3C',
                  margin: '0 0 6px', letterSpacing: '-0.02em',
                }}>Welcome Back 👋</h1>
                <p style={{ fontSize: 14, color: '#64748B', margin: 0 }}>
                  Who are you? Select your account type to continue.
                </p>
              </div>

              <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                {enabledTypes.map(t => {
                  const c = typeColors[t.id] || { color: '#0D9488', bg: '#CCFBF1' };
                  return (
                    <button key={t.id}
                      onClick={() => { setUserType(t.id); setStep('form'); setError(''); }}
                      className="type-card"
                      data-color={c.color} data-bg={c.bg}
                      style={{
                        display: 'flex', alignItems: 'center', gap: 16,
                        padding: '16px 20px',
                        border: '2px solid #CBD5E1', borderRadius: 14,
                        background: '#fff', transition: 'all 0.18s ease',
                        textAlign: 'left', cursor: 'pointer',
                        fontFamily: fontBody,
                      }}>
                      <div style={{
                        width: 44, height: 44, borderRadius: 12,
                        background: c.bg, color: c.color, flexShrink: 0,
                        display: 'flex', alignItems: 'center', justifyContent: 'center',
                        fontSize: 22,
                      }}>{t.icon}</div>
                      <div style={{ flex: 1 }}>
                        <div style={{ fontWeight: 700, fontSize: 15, color: '#1A2B3C' }}>{t.label}</div>
                        <div style={{ fontSize: 12, color: '#64748B', marginTop: 2 }}>
                          {typeSubtitles[t.id] || 'Continue as ' + t.label}
                        </div>
                      </div>
                      <div style={{ color: '#94A3B8', fontSize: 18 }}>→</div>
                    </button>
                  );
                })}
              </div>
            </>
          )}

          {/* STEP 2 — email / password form */}
          {step === 'form' && selectedType && (
            <>
              <button onClick={reset} style={{
                background: 'none', border: 'none', color: '#64748B',
                fontSize: 13, fontWeight: 600, padding: 0, marginBottom: 20,
                cursor: 'pointer', display: 'flex', alignItems: 'center', gap: 4,
              }}>← Back</button>

              <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 22 }}>
                {(() => {
                  const c = typeColors[selectedType.id] || { color: '#0D9488', bg: '#CCFBF1' };
                  return (
                    <div style={{
                      width: 44, height: 44, borderRadius: 12,
                      background: c.bg, color: c.color,
                      display: 'flex', alignItems: 'center', justifyContent: 'center',
                      fontSize: 22,
                    }}>{selectedType.icon}</div>
                  );
                })()}
                <div>
                  <h2 style={{
                    fontFamily: fontDisplay,
                    fontSize: 20, fontWeight: 800, color: '#1A2B3C',
                    margin: 0, letterSpacing: '-0.015em',
                  }}>{isSignup ? 'Create Account' : 'Sign In'}</h2>
                  <p style={{ fontSize: 13, color: '#64748B', margin: 0 }}>
                    As {selectedType.label}
                  </p>
                </div>
              </div>

              {/* Login / Sign Up pill toggle */}
              <div style={{
                display: 'flex', background: '#F0F4F8', borderRadius: 10,
                padding: 4, marginBottom: 18,
              }}>
                {[{ k: false, l: 'Login' }, { k: true, l: 'Sign Up' }].map(o => (
                  <button key={o.l}
                    onClick={() => { setIsSignup(o.k); setError(''); }}
                    style={{
                      flex: 1, padding: '8px',
                      border: 'none', borderRadius: 8,
                      fontWeight: 700, fontSize: 13, cursor: 'pointer',
                      background: isSignup === o.k ? '#fff' : 'transparent',
                      color: isSignup === o.k ? C.forestLight : '#64748B',
                      boxShadow: isSignup === o.k ? '0 1px 4px rgba(0,0,0,0.08)' : 'none',
                      transition: 'all 0.18s',
                      fontFamily: fontBody,
                    }}>{o.l}</button>
                ))}
              </div>

              {/* Password / OTP method pill */}
              <div style={{
                display: 'flex', gap: 8, marginBottom: 18,
              }}>
                {[{ k: 'password', l: copy.passwordTab || 'Password' },
                  { k: 'otp',      l: copy.otpTab || 'OTP' }].map(o => (
                  <button key={o.k} onClick={() => { setAuthMode(o.k); setError(''); }}
                    style={{
                      flex: 1, padding: '8px 12px',
                      border: `1.5px solid ${authMode === o.k ? C.forestLight : '#CBD5E1'}`,
                      background: authMode === o.k ? '#CCFBF1' : '#fff',
                      color: authMode === o.k ? C.forestMid : '#64748B',
                      borderRadius: 8, fontSize: 12, fontWeight: 700,
                      cursor: 'pointer', fontFamily: fontBody,
                      transition: 'all 0.15s',
                    }}>{o.l}</button>
                ))}
              </div>

              {isSignup && (
                <Field label="Full Name">
                  <input value={name} onChange={e => setName(e.target.value)}
                    placeholder="Enter your full name"
                    style={loginInputStyle} />
                </Field>
              )}

              <Field label={copy.emailLabel || 'Email Address'}>
                <input value={email} onChange={e => setEmail(e.target.value)}
                  placeholder={copy.emailPlaceholder || 'your@email.com'}
                  type="email" style={loginInputStyle} />
              </Field>

              {authMode === 'password' && (
                <Field label={copy.passwordLabel || 'Password'}>
                  <div style={{ position: 'relative' }}>
                    <input value={password} onChange={e => setPassword(e.target.value)}
                      placeholder={copy.passwordPlaceholder || 'Enter password'}
                      type={showPwd ? 'text' : 'password'}
                      style={{ ...loginInputStyle, paddingRight: 50 }}
                      onKeyDown={e => e.key === 'Enter' && handlePasswordSubmit()}
                    />
                    <button type="button" onClick={() => setShowPwd(!showPwd)} style={{
                      position: 'absolute', right: 14, top: '50%',
                      transform: 'translateY(-50%)',
                      background: 'none', border: 'none', color: '#64748B',
                      padding: 4, display: 'flex', cursor: 'pointer',
                    }} aria-label="Toggle password"><EyeIcon off={showPwd} /></button>
                  </div>
                </Field>
              )}

              {error && (
                <div style={{
                  color: '#DC2626', fontSize: 13, marginBottom: 12, fontWeight: 600,
                }}>{error}</div>
              )}

              <button
                onClick={authMode === 'password' ? handlePasswordSubmit : handleSendOTP}
                disabled={loading}
                style={{
                  width: '100%', padding: '13px',
                  background: loading ? '#94A3B8' : C.forestLight,
                  color: '#fff', border: 'none', borderRadius: 12,
                  fontSize: 15, fontWeight: 700, fontFamily: fontBody,
                  cursor: loading ? 'wait' : 'pointer',
                  display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8,
                  letterSpacing: '0.2px',
                  boxShadow: loading ? 'none' : `0 6px 16px ${C.forestLight}44`,
                  transition: 'all 0.18s',
                }}>
                {loading ? (
                  <div style={{
                    width: 18, height: 18, border: '2px solid rgba(255,255,255,0.3)',
                    borderTopColor: '#fff', borderRadius: '50%',
                    animation: 'spin 0.8s linear infinite',
                  }} />
                ) : (
                  authMode === 'password'
                    ? (isSignup ? 'Create Account →' : (copy.submitBtn || 'Login →'))
                    : (copy.sendOtpBtn || 'Send OTP') + ' →'
                )}
              </button>

              {authMode === 'otp' && (
                <p style={{
                  textAlign: 'center', fontSize: 12, color: '#64748B', marginTop: 14, marginBottom: 0,
                }}>We'll send a 6-digit code to your email.</p>
              )}
            </>
          )}

          {/* STEP 3 — OTP verification */}
          {step === 'otp' && (
            <>
              <button onClick={() => { setStep('form'); setError(''); setOtpDigits(['', '', '', '', '', '']); }} style={{
                background: 'none', border: 'none', color: '#64748B',
                fontSize: 13, fontWeight: 600, padding: 0, marginBottom: 20,
                cursor: 'pointer', display: 'flex', alignItems: 'center', gap: 4,
              }}>← Back</button>

              <div style={{ textAlign: 'center', marginBottom: 26 }}>
                <div style={{
                  width: 56, height: 56, borderRadius: 16,
                  background: '#CCFBF1',
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                  margin: '0 auto 16px', fontSize: 26,
                }}>📩</div>
                <h2 style={{
                  fontFamily: fontDisplay,
                  fontSize: 22, fontWeight: 800, color: '#1A2B3C',
                  margin: 0, letterSpacing: '-0.015em',
                }}>Check your email</h2>
                <p style={{ fontSize: 13, color: '#64748B', marginTop: 8, marginBottom: 0 }}>
                  We sent a 6-digit OTP to<br />
                  <strong style={{ color: '#1A2B3C' }}>{email}</strong>
                </p>
                <p style={{
                  fontSize: 12, color: C.forestLight, fontWeight: 600,
                  marginTop: 8, marginBottom: 0,
                }}>Demo OTP: <strong style={{
                  fontFamily: 'monospace', fontSize: 13, letterSpacing: '0.15em',
                }}>{demoOtp}</strong></p>
              </div>

              <div style={{
                display: 'flex', gap: 8, justifyContent: 'center', marginBottom: 22,
              }} onPaste={handleOTPPaste}>
                {otpDigits.map((d, i) => (
                  <input key={i}
                    ref={el => otpRefs.current[i] = el}
                    value={d}
                    onChange={e => handleOTPChange(i, e.target.value)}
                    onKeyDown={e => handleOTPKey(i, e)}
                    maxLength={1} inputMode="numeric"
                    style={{
                      width: 48, height: 56, textAlign: 'center',
                      fontSize: 22, fontWeight: 800, color: '#1A2B3C',
                      border: `2px solid ${d ? C.forestLight : '#CBD5E1'}`,
                      borderRadius: 12, outline: 'none',
                      fontFamily: 'monospace',
                      background: d ? '#CCFBF1' : '#fff',
                      transition: 'all 0.15s',
                    }}
                    autoFocus={i === 0}
                  />
                ))}
              </div>

              {error && (
                <div style={{
                  color: '#DC2626', fontSize: 13, marginBottom: 12,
                  fontWeight: 600, textAlign: 'center',
                }}>{error}</div>
              )}

              <button
                onClick={handleVerifyOTP}
                disabled={loading}
                style={{
                  width: '100%', padding: '13px',
                  background: loading ? '#94A3B8' : C.forestLight,
                  color: '#fff', border: 'none', borderRadius: 12,
                  fontSize: 15, fontWeight: 700, fontFamily: fontBody,
                  cursor: loading ? 'wait' : 'pointer',
                  display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8,
                  boxShadow: loading ? 'none' : `0 6px 16px ${C.forestLight}44`,
                }}>
                {loading ? (
                  <div style={{
                    width: 18, height: 18, border: '2px solid rgba(255,255,255,0.3)',
                    borderTopColor: '#fff', borderRadius: '50%',
                    animation: 'spin 0.8s linear infinite',
                  }} />
                ) : 'Verify & Continue ✓'}
              </button>

              <div style={{ textAlign: 'center', marginTop: 16 }}>
                {timer > 0 ? (
                  <span style={{ fontSize: 13, color: '#64748B' }}>
                    Resend OTP in <strong style={{ color: C.forestLight }}>{timer}s</strong>
                  </span>
                ) : (
                  <button onClick={handleSendOTP} style={{
                    background: 'none', border: 'none', color: C.forestLight,
                    fontSize: 13, fontWeight: 700, cursor: 'pointer', padding: 0,
                  }}>Resend OTP</button>
                )}
              </div>
            </>
          )}
        </div>

        {/* Page links footer */}
        {settings.pages?.some(p => p.enabled && p.inFooter) && (
          <div className="fadeUp" style={{
            marginTop: 22, display: 'flex', gap: 20, justifyContent: 'center',
            flexWrap: 'wrap', animationDelay: '0.3s',
          }}>
            {settings.pages.filter(p => p.enabled && p.inFooter).map(p => (
              <button key={p.id}
                onClick={() => onViewPage(p)}
                style={{
                  background: 'none', border: 'none',
                  fontFamily: fontBody,
                  fontSize: 13, fontWeight: 600,
                  color: 'rgba(255,255,255,0.7)',
                  padding: 0, cursor: 'pointer',
                }}>{p.title}</button>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

