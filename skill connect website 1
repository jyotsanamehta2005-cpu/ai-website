const SETTINGS_KEY = 'admin:settings';

async function loadSettings() {
  try {
    const r = await window.storage.get(SETTINGS_KEY);
    if (!r) return DEFAULT_SETTINGS;
    const parsed = JSON.parse(r.value);
    let merged = mergeSettings(DEFAULT_SETTINGS, parsed);
    // Migrate: add any new default nav items that aren't in stored settings
    if (merged.student?.nav) {
      const existing = new Set(merged.student.nav.map(n => n.id));
      const newOnes = DEFAULT_SETTINGS.student.nav.filter(n => !existing.has(n.id));
      if (newOnes.length) {
        const navWithNew = [...merged.student.nav];
        // Insert each new item near related items by default order
        DEFAULT_SETTINGS.student.nav.forEach((d, defaultIdx) => {
          if (!existing.has(d.id)) {
            // find insertion point: after the prior default that exists
            let insertAt = navWithNew.length;
            for (let i = defaultIdx - 1; i >= 0; i--) {
              const prevId = DEFAULT_SETTINGS.student.nav[i].id;
              const idx = navWithNew.findIndex(n => n.id === prevId);
              if (idx >= 0) { insertAt = idx + 1; break; }
            }
            navWithNew.splice(insertAt, 0, d);
            existing.add(d.id);
          }
        });
        merged = { ...merged, student: { ...merged.student, nav: navWithNew } };
      }
    }
    return merged;
  } catch (e) { return DEFAULT_SETTINGS; }
}
async function saveSettingsToStorage(settings) {
  try { await window.storage.set(SETTINGS_KEY, JSON.stringify(settings)); }
  catch (e) {}
}
async function clearSettings() {
  try { await window.storage.delete(SETTINGS_KEY); } catch (e) {}
}

