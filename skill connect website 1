}

function profileToText(p) {
  if (!p) return '';
  const lines = [];
  if (p.name) lines.push(p.name.toUpperCase());
  if (p.headline) lines.push(p.headline);
  const contact = [p.email, p.phone, p.location].filter(Boolean).join(' | ');
  if (contact) lines.push(contact);
  if (p.summary) lines.push('\nSUMMARY\n' + p.summary);
  if (p.skills?.length) lines.push('\nSKILLS\n' + p.skills.join(', '));
  if (p.education?.length) {
    lines.push('\nEDUCATION');
    p.education.forEach(e => lines.push(
      `${e.degree || ''} — ${e.institution || ''} (${e.year || ''})${e.score ? ` • ${e.score}` : ''}`.trim()
    ));
  }
  if (p.experience?.length) {
    lines.push('\nEXPERIENCE');
    p.experience.forEach(e => {
      lines.push(`${e.role || ''} at ${e.company || ''} (${e.duration || ''})`.trim());
      if (e.description) lines.push(e.description);
    });
  }
  if (p.projects?.length) {
    lines.push('\nPROJECTS');
    p.projects.forEach(pr => {
      lines.push(`${pr.name || ''}${pr.tech ? ` (${pr.tech})` : ''}`.trim());
      if (pr.description) lines.push(pr.description);
    });
  }
  if (p.certifications?.length) lines.push('\nCERTIFICATIONS\n' + p.certifications.join(', '));
  if (p.languages?.length) lines.push('\nLANGUAGES\n' + p.languages.join(', '));
  return lines.join('\n');
}

function calcCompleteness(p) {
  if (!p) return 0;
  const checks = [
    !!p.name, !!p.email, !!p.phone, !!p.location, !!p.headline, !!p.summary,
    p.skills?.length > 0, p.education?.length > 0,
    p.experience?.length > 0 || p.projects?.length > 0,
    p.certifications?.length > 0 || p.languages?.length > 0,
  ];
  return Math.round((checks.filter(Boolean).length / checks.length) * 100);
}

// Deep-merge defaults so missing keys are filled in (handles schema changes)
function mergeSettings(def, src) {
  if (Array.isArray(def)) return src ?? def;
  if (typeof def !== 'object' || def === null) return src ?? def;
  const out = {};
  for (const k in def) {
    out[k] = src && k in src ? mergeSettings(def[k], src[k]) : def[k];
  }
  return out;
}

function deepSet(obj, path, value) {
  const keys = path.split('.');
  const result = Array.isArray(obj) ? [...obj] : { ...obj };
  let cur = result;
  for (let i = 0; i < keys.length - 1; i++) {
    const k = keys[i];
    cur[k] = Array.isArray(cur[k]) ? [...cur[k]] : { ...cur[k] };
    cur = cur[k];
  }
  cur[keys[keys.length - 1]] = value;
  return result;
}

