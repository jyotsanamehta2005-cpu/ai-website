// ===========================================================================
// ADMIN PANEL
// ===========================================================================
const A = {
  bg: '#F0F4F8',
  card: '#FFFFFF',
  ink: '#0D2137',
  text: '#1A2B3C',
  muted: '#64748B',
  line: '#CBD5E1',
  lineSoft: '#E2E8F0',
  forest: '#0D2137',
  forestMid: '#1A3450',
  accent: '#0D9488',
  danger: '#DC2626',
  warn: '#F59E0B',
};

function AdminPanel({ settings, onSave, onExit, onReset }) {
  const [draft, setDraft] = useState(settings);
  const [section, setSection] = useState('brand');
  const [saving, setSaving] = useState(false);
  const [toast, setToast] = useState(null);

  // Sync if external settings change (e.g., on initial load)
  useEffect(() => { setDraft(settings); }, [settings]);

  const dirty = useMemo(
    () => JSON.stringify(draft) !== JSON.stringify(settings),
    [draft, settings]
  );

  const update = (path, value) => setDraft(prev => deepSet(prev, path, value));
  const showToast = (msg, kind='ok') => { setToast({ msg, kind }); setTimeout(() => setToast(null), 2400); };

  const handleSave = async () => {
    setSaving(true);
    await onSave(draft);
    setSaving(false);
    showToast('Changes saved');
  };
  const handleDiscard = () => { setDraft(settings); showToast('Changes discarded'); };
  const handleReset = async () => {
    if (confirm('Reset everything to defaults? Your customisations will be lost.')) {
      await onReset();
      showToast('Reset to defaults');
    }
  };

  const sections = [
    { k: 'brand',     l: 'Brand & Identity',   i: '🪪' },
    { k: 'fonts',     l: 'Fonts',              i: 'Aa' },
    { k: 'colors',    l: 'Colors & Theme',     i: '🎨' },
    { k: 'userTypes', l: 'User Types',         i: '👥' },
    { k: 'login',     l: 'Login Page Copy',    i: '📝' },
    { k: 'trust',     l: 'Trust Pill',         i: '⭐' },
    { k: 'chips',     l: 'Floating Icons',     i: '✨' },
    { k: 'student',   l: 'Student Dashboard',  i: '🎓' },
    { k: 'pages',     l: 'Pages',              i: '📄' },
    { k: 'companies', l: 'Companies',          i: '🏢' },
    { k: 'jobSources',l: 'Job Sources',        i: '🛰️' },
    { k: 'features',  l: 'Show / Hide',        i: '👁️' },
    { k: 'danger',    l: 'Reset',              i: '🔄', danger: true },
  ];

  return (
    <div style={{
      minHeight: '100vh', background: A.bg, fontFamily: fontBody,
      display: 'flex', color: A.text,
    }}>
      <style>{FONTS}</style>
      <style>{adminCSS()}</style>

      {toast && (
        <div className="fadeIn" style={{
          position: 'fixed', top: 24, right: 24, zIndex: 200,
          padding: '12px 20px',
          background: toast.kind === 'err' ? A.danger : A.forest,
          color: '#fff', borderRadius: 11, fontSize: 13, fontWeight: 600,
          boxShadow: '0 16px 32px rgba(0,0,0,0.15)',
        }}>{toast.msg}</div>
      )}

      {/* SIDEBAR */}
      <aside style={{
        width: 260, background: A.forest, color: '#fff',
        padding: 22, display: 'flex', flexDirection: 'column',
        position: 'sticky', top: 0, height: '100vh',
        overflow: 'hidden',
      }}>
        <div style={{ marginBottom: 22, paddingBottom: 22, borderBottom: '1px solid rgba(255,255,255,0.1)', flexShrink: 0 }}>
          <Logo light name={draft.brand.name} />
          <div style={{
            fontSize: 11, fontWeight: 700, letterSpacing: '0.18em',
            color: A.accent, marginTop: 10,
          }}>ADMIN PANEL</div>
        </div>

        <nav className="admin-scroll" style={{
          flex: 1, minHeight: 0, overflowY: 'auto',
          margin: '0 -6px', padding: '4px 6px',
        }}>
          {sections.map(s => {
            const isActive = section === s.k;
            return (
              <button key={s.k} onClick={() => setSection(s.k)} className="admin-nav"
                style={{
                  width: '100%', padding: '10px 13px', marginBottom: 3,
                  display: 'flex', alignItems: 'center', gap: 11,
                  background: isActive ? 'rgba(255,255,255,0.1)' : 'transparent',
                  color: s.danger ? '#FCA5A5' : (isActive ? '#fff' : 'rgba(255,255,255,0.8)'),
                  border: 'none', borderRadius: 9,
                  fontSize: 13, fontWeight: 600, textAlign: 'left',
                  cursor: 'pointer', fontFamily: fontBody,
                }}>
                <span style={{ fontSize: 15 }}>{s.i}</span>
                <span>{s.l}</span>
              </button>
            );
          })}
        </nav>

        <button onClick={onExit} style={{
          marginTop: 14, padding: '10px 14px',
          background: 'rgba(255,255,255,0.08)', color: '#fff',
          border: '1px solid rgba(255,255,255,0.12)', borderRadius: 9,
          fontSize: 13, fontWeight: 600, cursor: 'pointer',
          display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8,
          fontFamily: fontBody, flexShrink: 0,
        }}>← Back to site</button>
      </aside>

      {/* MAIN */}
      <main style={{ flex: 1, padding: 36, paddingBottom: dirty ? 120 : 36, overflow: 'auto' }}>
        <div style={{ maxWidth: 880, margin: '0 auto' }}>
          {section === 'brand'     && <BrandSection     draft={draft} update={update} />}
          {section === 'fonts'     && <FontsSection     draft={draft} update={update} />}
          {section === 'colors'    && <ColorsSection    draft={draft} update={update} />}
          {section === 'userTypes' && <UserTypesSection draft={draft} update={update} />}
          {section === 'login'     && <LoginCopySection draft={draft} update={update} />}
          {section === 'trust'     && <TrustSection     draft={draft} update={update} />}
          {section === 'chips'     && <ChipsSection     draft={draft} update={update} />}
          {section === 'student'   && <StudentSection   draft={draft} update={update} />}
          {section === 'pages'     && <PagesSection     draft={draft} update={update} />}
          {section === 'companies' && <CompaniesSection draft={draft} update={update} />}
          {section === 'jobSources' && <JobSourcesSection draft={draft} update={update} />}
          {section === 'features'  && <FeaturesSection  draft={draft} update={update} />}
          {section === 'danger'    && <DangerSection    onReset={handleReset} />}
        </div>
      </main>

      {/* SAVE BAR */}
      {dirty && (
        <div className="saveBar" style={{
          position: 'fixed', bottom: 24, left: '50%',
          transform: 'translateX(calc(-50% + 130px))',
          background: A.forest, color: '#fff',
          padding: '12px 16px 12px 22px', borderRadius: 100,
          display: 'flex', alignItems: 'center', gap: 14,
          boxShadow: '0 16px 40px rgba(0,0,0,0.2)',
          zIndex: 100, animation: 'fadeUp 0.3s ease both',
        }}>
          <div style={{
            display: 'flex', alignItems: 'center', gap: 8,
            fontSize: 13, fontWeight: 600,
          }}>
            <span className="pulse-dot" style={{
              width: 8, height: 8, borderRadius: '50%', background: A.warn,
            }} />
            Unsaved changes
          </div>
          <button onClick={handleDiscard} style={{
            padding: '8px 14px',
            background: 'rgba(255,255,255,0.1)', color: '#fff',
            border: '1px solid rgba(255,255,255,0.15)', borderRadius: 100,
            fontSize: 12, fontWeight: 600, cursor: 'pointer', fontFamily: fontBody,
          }}>Discard</button>
          <button onClick={handleSave} disabled={saving} style={{
            padding: '8px 18px',
            background: A.accent, color: '#08231C',
            border: 'none', borderRadius: 100,
            fontSize: 12, fontWeight: 800, cursor: 'pointer', fontFamily: fontBody,
          }}>{saving ? 'Saving…' : 'Save changes'}</button>
        </div>
      )}
    </div>
  );
}

function adminCSS() {
  return `
    .admin-nav { transition: background 0.15s ease; }
    .admin-nav:hover { background: rgba(255,255,255,0.06) !important; }
    .admin-input { transition: all 0.15s ease; }
    .admin-input:focus {
      outline: none;
      border-color: ${A.forest} !important;
      background: #fff !important;
      box-shadow: 0 0 0 4px ${A.forest}14 !important;
    }
    .admin-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(8,35,28,0.12); }
    .pulse-dot { animation: pulseDot 1.6s ease infinite; }
    @keyframes pulseDot { 0%,100% { opacity: 0.5; } 50% { opacity: 1; } }
    .ghost-btn:hover { background: ${A.lineSoft} !important; }
    .danger-btn:hover { background: #FEE2E2 !important; border-color: ${A.danger} !important; }
    /* Sidebar nav scrollbar — slim and dark-bg friendly */
    .admin-scroll::-webkit-scrollbar { width: 6px; }
    .admin-scroll::-webkit-scrollbar-track { background: transparent; }
    .admin-scroll::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.12);
      border-radius: 3px;
    }
    .admin-scroll::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.22); }
    .admin-scroll { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.12) transparent; }
  `;
}

